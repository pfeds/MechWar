@page "/game"
@using MechWar.Components
@using MechWar.Data
@using MechWar.Models
@using MechWar.Services
@using Microsoft.AspNetCore.Components.Web
@inject IMapGenerator MapGenerator
@inject GameUiState UiState
@inject IJSRuntime JsRuntime
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>MechWar — Battle</PageTitle>

<div class="battlefield-container">
	<div class="battlefield-main">
		<div class="map-wrapper">
			<div class="battlefield-input"
				 tabindex="0"
				 @ref="BattlefieldInputRef"
				 @onclick="FocusBattlefield"
				 @onkeydown="HandleBattlefieldKey"
				 @onkeydown:preventDefault="true">
				<div class="map-status-overlay">
					<div class="status-round-phase">Round @RoundNumber · @(IsPlayerPhase ? "Your Turn" : "Enemy's Turn")</div>
					<div class="status-theme">@CurrentMap?.Theme.DisplayName</div>
				</div>

				<HexMapView
					Map="CurrentMap"
					Mech="UserMech"
					EnemyMech="EnemyMech"
					PlayerArcTiles="PlayerFiringArcTiles"
					PlayerMechTooltip="@BuildPlayerMechTooltip()"
					EnemyMechTooltip="@BuildEnemyMechTooltip()"
					PlayerMuzzleFlash="@PlayerMuzzleFlash"
					EnemyMuzzleFlash="@EnemyMuzzleFlash"
					PlayerImpactText="@PlayerImpactText"
					PlayerImpactDamageText="@PlayerImpactDamageText"
					PlayerImpactIsHit="@PlayerImpactIsHit"
					PlayerImpactIsDestruction="@PlayerImpactIsDestruction"
					EnemyImpactText="@EnemyImpactText"
					EnemyImpactDamageText="@EnemyImpactDamageText"
					EnemyImpactIsHit="@EnemyImpactIsHit"
					EnemyImpactIsDestruction="@EnemyImpactIsDestruction" />
			</div>

			<div class="map-bottom-panel">
				<div class="mech-control-panel">
					@if (!IsGameOver)
					{
						<div class="control-group mode-group">
							<span class="mode-label">MODE:</span>
							<button class="control-btn @GetModeButtonClass(MovementMode.Walk)" @onclick="() => TrySetMovementMode(MovementMode.Walk)" title="Walk mode (1 or W)">WALK</button>
							<button class="control-btn @GetModeButtonClass(MovementMode.Run)" @onclick="() => TrySetMovementMode(MovementMode.Run)" title="Run mode (2 or R)">RUN</button>
							<button class="control-btn @GetModeButtonClass(MovementMode.Jump)" @onclick="() => TrySetMovementMode(MovementMode.Jump)" title="Jump mode (3 or J)">JUMP</button>
						</div>
						<div class="control-group move-group">
							<button class="control-btn move-btn" @onclick="() => TryRotate(1)" disabled="@(!IsPlayerPhase || IsGameOver || UserMech is null)" title="Turn left (←)">↺</button>
							<button class="control-btn move-btn" @onclick="() => TryMove(true)" disabled="@(!IsPlayerPhase || IsGameOver || UserMech is null)" title="Move forward (↑)">↑</button>
							<button class="control-btn move-btn" @onclick="() => TryMove(false)" disabled="@(!IsPlayerPhase || IsGameOver || UserMech is null)" title="Move back (↓)">↓</button>
							<button class="control-btn move-btn" @onclick="() => TryRotate(-1)" disabled="@(!IsPlayerPhase || IsGameOver || UserMech is null)" title="Turn right (→)">↻</button>
						</div>
						<div class="control-group fire-group">
							<button class="control-btn fire-btn" @onclick="ResolvePlayerAttack" disabled="@(UserMech is null || EnemyMech is null || !IsPlayerPhase || !CanPlayerFire)" title="Fire weapons (F or Space)">FIRE</button>
							<button class="control-btn end-btn" @onclick="EndPlayerTurn" disabled="@(UserMech is null || !IsPlayerPhase)" title="End your turn">END TURN</button>
						</div>
					}
					else
					{
						<div class="control-group end-game-group">
							<span class="game-over-status @(PlayerWon ? "status-win" : "status-lose")">@(PlayerWon ? "✓ VICTORY" : "✗ DEFEAT")</span>
							<button class="control-btn new-game-btn" @onclick="GoToNewGame">NEW GAME</button>
						</div>
					}
				</div>
			</div>
		</div>

		<aside class="control-panel">
			<div class="console-divider"></div>
			<section class="panel-card console-panel">
				<h3>CONSOLE</h3>
				<div class="matrix-console" @ref="ConsoleOutputRef">
				@foreach (var line in CombatLog)
				{
					var parsedLine = ParseConsoleLine(line);
					<div class="@GetLogCssClass(line)">
						@if (!string.IsNullOrWhiteSpace(parsedLine.Prefix))
						{
							<span class="@GetPrefixCssClass(parsedLine.Prefix)">@parsedLine.Prefix</span><span> </span>
						}
						@parsedLine.Message
					</div>
				}
			</div>
		</section>
	</aside>
	</div>
</div>

@if (IsGameOver && ShowGameOverOverlay)
{
	<div class="game-over-overlay">
		<div class="game-over-content">
			<h1 class="game-over-text">GAME OVER</h1>
			<p class="game-result @(PlayerWon ? "win" : "lose")">
				@(PlayerWon ? "You win!" : "You lose!")
			</p>
			<div class="game-over-buttons">
				<button class="btn btn-outline-light btn-lg mt-4" @onclick="DismissGameOverOverlay">
					View Battle
				</button>
				<button class="btn btn-primary btn-lg mt-4" @onclick="GoToNewGame">
					New Game
				</button>
			</div>
		</div>
	</div>
}

@code {
	private readonly HashSet<(int Column, int Row)> PlayerFiringArcTiles = new();
	private readonly Dictionary<(int Column, int Row), TerrainType> TerrainByCoordinate = new();
	private readonly Dictionary<(int Column, int Row), HexTile> TileByCoordinate = new();
	private readonly Dictionary<HitLocation, SectionState> PlayerSections = new();
	private readonly Dictionary<HitLocation, SectionState> EnemySections = new();
	private readonly Dictionary<HitLocation, SectionState> PlayerMaxSections = new();
	private readonly Dictionary<HitLocation, SectionState> EnemyMaxSections = new();
	private readonly Dictionary<HitLocation, List<ComponentStatus>> PlayerComponents = new();
	private readonly Dictionary<HitLocation, List<ComponentStatus>> EnemyComponents = new();

	private string SelectedThemeKey { get; set; } = string.Empty;
	private int Width { get; set; } = 28;
	private int Height { get; set; } = 20;
	private MovementMode ActiveMovementMode { get; set; } = MovementMode.Walk;
	private int CurrentSeed { get; set; } = Random.Shared.Next(100_000, 999_999);
	private HexMap? CurrentMap { get; set; }
	private PlayerMech? UserMech { get; set; }
	private PlayerMech? EnemyMech { get; set; }
	private ElementReference BattlefieldInputRef { get; set; }
	private ElementReference ConsoleOutputRef { get; set; }
	private bool ShouldAutoScrollConsole { get; set; }
	private const int ConsoleAutoScrollThresholdPx = 48;
	private int RoundNumber { get; set; } = 1;
	private bool IsPlayerPhase { get; set; } = true;
	private readonly List<string> CombatLog = new();

	private string SelectedPlayerMechName { get; set; } = "Jenner JR7-D";
	private string SelectedEnemyMechName { get; set; } = "Hunchback HBK-4G";

	private enum LogEntryType { Normal, Hit, Miss, Destruction }
	private readonly record struct ConsoleLineParts(string? Prefix, string Message);
	private string _lastActionMessage = string.Empty;
	private string LastActionMessage
	{
		get => _lastActionMessage;
		set
		{
			_lastActionMessage = value;
			AddConsoleLine(value);
		}
	}
	private int PlayerArmor { get; set; }
	private int PlayerInternal { get; set; }
	private int EnemyArmor { get; set; }
	private int EnemyInternal { get; set; }
	private int PlayerHexesMovedThisTurn { get; set; }
	private int EnemyHexesMovedLastTurn { get; set; }
	private bool HasPlayerFiredThisTurn { get; set; }
	private int PlayerHeat { get; set; }
	private int EnemyHeat { get; set; }
	private bool PlayerShutdown { get; set; }
	private bool EnemyShutdown { get; set; }
	private bool PlayerAmmoIntact { get; set; } = true;
	private bool EnemyAmmoIntact { get; set; } = true;
	private string LastEnemyAttackMessage { get; set; } = string.Empty;
	private bool IsGameOver { get; set; }
	private bool PlayerWon { get; set; }
	private bool ShowGameOverOverlay { get; set; }
	private bool PlayerMuzzleFlash { get; set; }
	private bool EnemyMuzzleFlash { get; set; }
	private string? PlayerImpactText { get; set; }
	private string? EnemyImpactText { get; set; }
	private string? PlayerImpactDamageText { get; set; }
	private string? EnemyImpactDamageText { get; set; }
	private bool PlayerImpactIsHit { get; set; }
	private bool EnemyImpactIsHit { get; set; }
	private bool PlayerImpactIsDestruction { get; set; }
	private bool EnemyImpactIsDestruction { get; set; }

	private const int BaseToHit = 4;
	private const int MaxWeaponRange = 9;
	private const int WeaponDamage = 5;
	private const int WeaponHeat = 4;
	private const int HeatSinkValue = 6;
	private const int CriticalHitThreshold = 10;
	private const int MinMapWidth = 8;
	private const int MaxMapWidth = 80;
	private const int MinMapHeight = 8;
	private const int MaxMapHeight = 60;

	private bool IsCreateGameFormValid =>
		Width >= MinMapWidth && Width <= MaxMapWidth && Height >= MinMapHeight && Height <= MaxMapHeight;

	private string CreateGameValidationMessage =>
		$"Map size must be between {MinMapWidth}-{MaxMapWidth} wide and {MinMapHeight}-{MaxMapHeight} high.";

	private string CreateGameSpawnPreview
	{
		get
		{
			if (!IsCreateGameFormValid)
				return "Set a valid map size to preview spawn bands.";
			var minDistance = GetMinSpawnDistance(Width);
			var maxDistance = GetMaxSpawnDistance(Width, minDistance);
			return $"Spawn preview: each mech spawns on opposite sides, {minDistance}-{maxDistance} hexes from its edge, any row 0-{Height - 1}.";
		}
	}

	private readonly record struct ComponentStatus(ComponentType Type, bool IsDestroyed);
	private readonly record struct SectionState(int Armor, int Internal);

	protected override void OnInitialized()
	{
		UiState.StateChanged += HandleUiStateChanged;
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			// Read settings from GameUiState (set by Home page)
			SelectedThemeKey = string.IsNullOrEmpty(UiState.SelectedThemeKey)
				? ThemeCatalog.All[0].Key
				: UiState.SelectedThemeKey;
			Width = UiState.MapWidth > 0 ? UiState.MapWidth : 28;
			Height = UiState.MapHeight > 0 ? UiState.MapHeight : 20;
			SelectedPlayerMechName = string.IsNullOrEmpty(UiState.PlayerMechName)
				? "Jenner JR7-D"
				: UiState.PlayerMechName;
			SelectedEnemyMechName = string.IsNullOrEmpty(UiState.EnemyMechName)
				? "Hunchback HBK-4G"
				: UiState.EnemyMechName;
			UiState.ConsumeGame();
			GenerateMap();
			StateHasChanged();
			try
			{
				await FocusBattlefield();
			}
			catch
			{
				// Focus is a progressive enhancement and should not break initial page render.
			}
		}

		if (ShouldAutoScrollConsole)
		{
			ShouldAutoScrollConsole = false;
			try
			{
				await JsRuntime.InvokeVoidAsync("mechWarUi.scrollElementToBottomIfNearBottom", ConsoleOutputRef, ConsoleAutoScrollThresholdPx);
			}
			catch
			{
				// Console auto-scroll should never interrupt gameplay.
			}
		}
	}

	public void Dispose()
	{
		UiState.StateChanged -= HandleUiStateChanged;
	}

	private void GenerateMap()
	{
		Width = Math.Clamp(Width, MinMapWidth, MaxMapWidth);
		Height = Math.Clamp(Height, MinMapHeight, MaxMapHeight);
		var theme = ThemeCatalog.Get(SelectedThemeKey);
		CurrentSeed = Random.Shared.Next(int.MinValue, int.MaxValue);
		CurrentMap = MapGenerator.Generate(theme, Width, Height, CurrentSeed);
		BuildTerrainIndex();
		DeployUserMech();
	}

	private void BuildTerrainIndex()
	{
		TerrainByCoordinate.Clear();
		TileByCoordinate.Clear();

		if (CurrentMap is null)
			return;

		foreach (var tile in CurrentMap.Tiles)
		{
			TerrainByCoordinate[(tile.Column, tile.Row)] = tile.Terrain;
			TileByCoordinate[(tile.Column, tile.Row)] = tile;
		}
	}

	private void DeployUserMech()
	{
		if (CurrentMap is null)
			return;

		var playerDef = MechCatalog.Get(SelectedPlayerMechName) ?? throw new InvalidOperationException($"Mech not found: {SelectedPlayerMechName}");
		var enemyDef = MechCatalog.Get(SelectedEnemyMechName) ?? throw new InvalidOperationException($"Mech not found: {SelectedEnemyMechName}");

		var playerOnLeft = Random.Shared.Next(0, 2) == 0;
		var playerSpawn = FindSideSpawnTile(playerOnLeft);
		var playerMovement = GetMechMpByMode(playerDef, ActiveMovementMode);
		var playerFacing = playerOnLeft ? HexDirection.East : HexDirection.West;
		UserMech = new PlayerMech(SelectedPlayerMechName, playerDef.Class, playerSpawn.Column, playerSpawn.Row, playerFacing, playerMovement, playerMovement, playerDef.Weapons, playerDef.WalkSpeed, playerDef.RunSpeed, playerDef.JumpSpeed);

		var enemySpawn = FindSideSpawnTile(!playerOnLeft);
		var enemyFacing = playerOnLeft ? HexDirection.West : HexDirection.East;
		EnemyMech = new PlayerMech(SelectedEnemyMechName, enemyDef.Class, enemySpawn.Column, enemySpawn.Row, enemyFacing, 0, 0, enemyDef.Weapons, enemyDef.WalkSpeed, enemyDef.RunSpeed, enemyDef.JumpSpeed);

		RoundNumber = 1;
		IsPlayerPhase = true;
		IsGameOver = false;
		ShowGameOverOverlay = false;
		PlayerWon = false;
		InitializeSections(PlayerSections, playerDef);
		InitializeSections(EnemySections, enemyDef);
		foreach (var kvp in PlayerSections) PlayerMaxSections[kvp.Key] = kvp.Value;
		foreach (var kvp in EnemySections) EnemyMaxSections[kvp.Key] = kvp.Value;
		InitializeComponents(PlayerComponents);
		InitializeComponents(EnemyComponents);
		RecalculateDurabilityTotals();
		PlayerHexesMovedThisTurn = 0;
		EnemyHexesMovedLastTurn = 0;
		HasPlayerFiredThisTurn = false;
		PlayerHeat = 0;
		EnemyHeat = 0;
		PlayerShutdown = false;
		EnemyShutdown = false;
		PlayerAmmoIntact = true;
		EnemyAmmoIntact = true;
		LastEnemyAttackMessage = string.Empty;
		ClearCombatFx();
		UpdatePlayerFiringArc();
		LastActionMessage = $"{playerDef.Name} deployed against {enemyDef.Name}. Round 1 starts in {ActiveMovementMode} mode.";
	}

	private (int Column, int Row) FindSideSpawnTile(bool leftSide)
	{
		if (CurrentMap is null)
			return (0, 0);

		var minDistance = GetMinSpawnDistance(CurrentMap.Width);
		var maxDistance = GetMaxSpawnDistance(CurrentMap.Width, minDistance);
		var preferredColumns = new List<int>();

		for (var distance = minDistance; distance <= maxDistance; distance++)
		{
			var column = leftSide ? distance : (CurrentMap.Width - 1 - distance);
			if (column >= 0 && column < CurrentMap.Width)
				preferredColumns.Add(column);
		}

		preferredColumns = preferredColumns.Distinct().ToList();

		var shuffledRows = Enumerable.Range(0, CurrentMap.Height)
			.OrderBy(_ => Random.Shared.Next())
			.ToList();

		foreach (var column in preferredColumns.OrderBy(_ => Random.Shared.Next()))
		{
			foreach (var row in shuffledRows)
			{
				if (IsTraversable(column, row))
					return (column, row);
			}
		}

		return FindSpawnTile();
	}

	private static int GetMinSpawnDistance(int mapWidth) => Math.Min(3, Math.Max(1, (mapWidth / 2) - 1));
	private static int GetMaxSpawnDistance(int mapWidth, int minDistance) => Math.Min(6, Math.Max(minDistance, mapWidth - 2));

	private (int Column, int Row) FindSpawnTile()
	{
		if (CurrentMap is null)
			return (0, 0);

		var centerColumn = CurrentMap.Width / 2;
		var centerRow = CurrentMap.Height / 2;
		var maxRadius = Math.Max(CurrentMap.Width, CurrentMap.Height);

		for (var radius = 0; radius <= maxRadius; radius++)
		{
			for (var row = Math.Max(0, centerRow - radius); row <= Math.Min(CurrentMap.Height - 1, centerRow + radius); row++)
			{
				for (var column = Math.Max(0, centerColumn - radius); column <= Math.Min(CurrentMap.Width - 1, centerColumn + radius); column++)
				{
					if (IsTraversable(column, row))
						return (column, row);
				}
			}
		}

		return (0, 0);
	}

	private async Task FocusBattlefield()
	{
		await BattlefieldInputRef.FocusAsync();
	}

	private void HandleUiStateChanged()
	{
		InvokeAsync(StateHasChanged);
	}

	private void ClearCombatFx()
	{
		PlayerMuzzleFlash = false;
		EnemyMuzzleFlash = false;
		PlayerImpactText = null;
		EnemyImpactText = null;
		PlayerImpactDamageText = null;
		EnemyImpactDamageText = null;
		PlayerImpactIsHit = false;
		EnemyImpactIsHit = false;
		PlayerImpactIsDestruction = false;
		EnemyImpactIsDestruction = false;
	}

	private async Task PlayShotAnimation(bool attackerIsPlayer, bool targetIsPlayer, bool hit, string? impactDetail)
	{
		ClearCombatFx();
		await PlayCombatSoundAsync("fire");
		if (attackerIsPlayer)
			PlayerMuzzleFlash = true;
		else
			EnemyMuzzleFlash = true;

		await InvokeAsync(StateHasChanged);
		await Task.Delay(180);

		PlayerMuzzleFlash = false;
		EnemyMuzzleFlash = false;

		if (hit)
			await PlayCombatSoundAsync("hit");

		if (targetIsPlayer)
		{
			PlayerImpactText = hit ? "Hit!" : "Miss";
			PlayerImpactDamageText = hit ? impactDetail : null;
			PlayerImpactIsHit = hit;
		}
		else
		{
			EnemyImpactText = hit ? "Hit!" : "Miss";
			EnemyImpactDamageText = hit ? impactDetail : null;
			EnemyImpactIsHit = hit;
		}

		await InvokeAsync(StateHasChanged);
		await Task.Delay(620);
		ClearCombatFx();
		await InvokeAsync(StateHasChanged);
	}

	private async Task PlayCombatSoundAsync(string soundName)
	{
		try
		{
			await JsRuntime.InvokeVoidAsync("mechWarAudio.play", soundName);
		}
		catch
		{
			// Audio should never interrupt combat flow.
		}
	}

	private static string BuildImpactDamageText(HitLocation location, int armorDamage, int internalDamage)
	{
		var locationText = FormatLocation(location);
		return (armorDamage, internalDamage) switch
		{
			(> 0, > 0) => $"{locationText} hit for {armorDamage} armour and {internalDamage} internal damage!",
			(> 0, 0) => $"{locationText} hit for {armorDamage} armour damage!",
			(0, > 0) => $"{locationText} hit for {internalDamage} internal damage!",
			_ => $"{locationText} hit!"
		};
	}

	private async Task AnimateAiStep(int delayMs)
	{
		await InvokeAsync(StateHasChanged);
		await Task.Delay(delayMs);
	}

	private bool CanPlayerFire =>
		UserMech is not null &&
		EnemyMech is not null &&
		!HasPlayerFiredThisTurn &&
		!PlayerShutdown &&
		PlayerInternal > 0 &&
		HasOperationalWeapons(UserMech.Weapons, PlayerSections, PlayerComponents) &&
		EnemyInternal > 0 &&
		!IsArmDestroyed(PlayerSections);

	private static bool HasOperationalWeapons(
		IReadOnlyList<Weapon>? weapons,
		Dictionary<HitLocation, SectionState> sections,
		Dictionary<HitLocation, List<ComponentStatus>> components) =>
		GetOperationalWeapons(weapons, sections, components).Count > 0;

	private static IReadOnlyList<Weapon> GetOperationalWeapons(
		IReadOnlyList<Weapon>? weapons,
		Dictionary<HitLocation, SectionState> sections,
		Dictionary<HitLocation, List<ComponentStatus>> components)
	{
		if (weapons is null || weapons.Count == 0)
		{
			return new List<Weapon>();
		}

		var operational = new List<Weapon>();
		foreach (var group in weapons.GroupBy(w => w.Location))
		{
			if (!sections.TryGetValue(group.Key, out var section) || section.Internal <= 0)
			{
				continue;
			}

			var destroyedWeaponSlots = 0;
			if (components.TryGetValue(group.Key, out var parts))
			{
				destroyedWeaponSlots = parts.Count(p => p.Type == ComponentType.Weapon && p.IsDestroyed);
			}

			var locationWeapons = group.ToList();
			var survivingCount = Math.Max(0, locationWeapons.Count - destroyedWeaponSlots);
			if (survivingCount > 0)
			{
				operational.AddRange(locationWeapons.Take(survivingCount));
			}
		}

		return operational;
	}

	private static IReadOnlyList<Weapon> GetFiredWeapons(IReadOnlyList<Weapon>? weapons, MovementMode mode)
	{
		if (weapons is null || weapons.Count == 0)
			return new List<Weapon>();

		if (mode == MovementMode.Walk)
			return weapons.ToList();

		var sorted = weapons.OrderByDescending(w => w.Damage).ToList();
		var fireCount = Math.Max(1, sorted.Count / 2);
		return sorted.Take(fireCount).ToList();
	}

	private static string FormatWeaponList(IReadOnlyList<Weapon> weapons)
	{
		if (weapons.Count == 0)
			return "No weapons";
		return weapons.Count == 1 ? weapons[0].Name : string.Join(", ", weapons.Select(w => w.Name));
	}

	private async Task ResolvePlayerAttack()
	{
		if (!IsPlayerPhase || !CanPlayerFire || UserMech is null || EnemyMech is null)
			return;

		if (!PlayerFiringArcTiles.Contains((EnemyMech.Column, EnemyMech.Row)))
		{
			LastActionMessage = "Enemy is outside your front firing arc.";
			return;
		}

		var range = CubeDistance(UserMech.Column, UserMech.Row, EnemyMech.Column, EnemyMech.Row);
		var rangeModifier = GetRangeModifier(range);
		if (rangeModifier >= 99)
		{
			LastActionMessage = "Enemy is out of weapon range.";
			return;
		}

		if (!CanFireBetween(UserMech.Column, UserMech.Row, EnemyMech.Column, EnemyMech.Row, out var losBlockedMessage, out var terrainFiringModifier))
		{
			LastActionMessage = losBlockedMessage;
			return;
		}

		var attackerModifier = GetAttackerMovementModifier(ActiveMovementMode, PlayerHexesMovedThisTurn);
		var targetModifier = GetTargetMovementModifier(EnemyHexesMovedLastTurn);
		var heatModifier = GetHeatToHitModifier(PlayerHeat);
		var gyroModifier = IsComponentDestroyed(PlayerComponents, ComponentType.Gyro) ? 2 : 0;
		var targetNumber = BaseToHit + rangeModifier + attackerModifier + targetModifier + heatModifier + gyroModifier + terrainFiringModifier;
		var roll = Roll2d6();

		var operationalWeapons = GetOperationalWeapons(UserMech.Weapons, PlayerSections, PlayerComponents);
		if (operationalWeapons.Count == 0)
		{
			LastActionMessage = "No operational weapons remain.";
			return;
		}

		HasPlayerFiredThisTurn = true;

		var firedWeapons = GetFiredWeapons(operationalWeapons, ActiveMovementMode);
		var weaponDamage = firedWeapons.Sum(w => w.Damage);
		var weaponHeat = firedWeapons.Sum(w => w.Heat);
		AddPlayerHeat(weaponHeat);

		var modBreakdown = FormatModifierBreakdown(BaseToHit, rangeModifier, attackerModifier, targetModifier, heatModifier, gyroModifier, terrainFiringModifier);

		if (roll < targetNumber)
		{
			await PlayShotAnimation(attackerIsPlayer: true, targetIsPlayer: false, hit: false, impactDetail: null);
			var weaponLog = FormatWeaponList(firedWeapons);
			LastActionMessage = $"MISS — {weaponLog} fired; rolled {roll} vs TN {targetNumber} ({modBreakdown}).";
			return;
		}

		var enemyArc = GetIncomingArc(EnemyMech.Facing, EnemyMech.Column, EnemyMech.Row, UserMech.Column, UserMech.Row);
		var hitLocation = RollHitLocation(enemyArc, Roll2d6());
		ApplyDamage(EnemySections, hitLocation, weaponDamage, out var armorDamage, out var internalDamage, out var transferredToCt);
		var criticalHitMsg = string.Empty;
		if (internalDamage > 0)
			criticalHitMsg = RollCriticalHit(EnemyComponents, hitLocation);

		var impactDetail = BuildImpactDamageText(hitLocation, armorDamage, internalDamage);
		await PlayShotAnimation(attackerIsPlayer: true, targetIsPlayer: false, hit: true, impactDetail: impactDetail);
		RecalculateDurabilityTotals();
		var weaponLog2 = FormatWeaponList(firedWeapons);
		var finalPlayerAttackMessage = $"HIT — {weaponLog2} fired; rolled {roll} vs TN {targetNumber} ({modBreakdown}). {enemyArc} arc → {FormatLocation(hitLocation)}: {armorDamage} armor / {internalDamage} internal.";
		if (!string.IsNullOrWhiteSpace(criticalHitMsg))
			finalPlayerAttackMessage += $" {criticalHitMsg}";
		if (transferredToCt > 0)
			finalPlayerAttackMessage += $" +{transferredToCt} overflow to Center Torso.";

		if (EnemyInternal <= 0)
			finalPlayerAttackMessage += " Enemy mech destroyed.";

		LastActionMessage = finalPlayerAttackMessage;

		CheckGameOver();
	}

	private string GetPlayerToHitDisplay()
	{
		if (UserMech is null || EnemyMech is null)
			return "N/A";

		if (!PlayerFiringArcTiles.Contains((EnemyMech.Column, EnemyMech.Row)))
			return "No shot (outside arc)";

		var range = CubeDistance(UserMech.Column, UserMech.Row, EnemyMech.Column, EnemyMech.Row);
		var rangeModifier = GetRangeModifier(range);
		if (rangeModifier >= 99)
			return "No shot (out of range)";

		if (!CanFireBetween(UserMech.Column, UserMech.Row, EnemyMech.Column, EnemyMech.Row, out var losBlockedMessage, out var terrainFiringModifier))
			return losBlockedMessage;

		var attackerModifier = GetAttackerMovementModifier(ActiveMovementMode, PlayerHexesMovedThisTurn);
		var targetModifier = GetTargetMovementModifier(EnemyHexesMovedLastTurn);
		var heatModifier = GetHeatToHitModifier(PlayerHeat);
		var gyroModifier = IsComponentDestroyed(PlayerComponents, ComponentType.Gyro) ? 2 : 0;
		var targetNumber = BaseToHit + rangeModifier + attackerModifier + targetModifier + heatModifier + gyroModifier + terrainFiringModifier;
		return $"{targetNumber}+ (base {BaseToHit} + range {rangeModifier} + move {attackerModifier} + target {targetModifier} + heat {heatModifier} + terrain {terrainFiringModifier})";
	}

	private async Task EndPlayerTurn()
	{
		if (UserMech is null || EnemyMech is null)
			return;

		if (PlayerInternal <= 0 || EnemyInternal <= 0)
		{
			LastActionMessage = "Battle is already resolved.";
			return;
		}

		ApplyHeatEndPhase(isPlayer: true);
		if (PlayerInternal <= 0)
		{
			LastActionMessage = "Your mech has been destroyed by heat effects.";
			return;
		}

		IsPlayerPhase = false;
		await ExecuteEnemyTurn();
		if (!string.IsNullOrWhiteSpace(LastEnemyAttackMessage))
		{
			_lastActionMessage = LastEnemyAttackMessage;
			AddConsoleLine(LastEnemyAttackMessage);
		}
		else if (PlayerShutdown)
		{
			_lastActionMessage = "Player remains shutdown.";
		}

		if (IsGameOver || PlayerInternal <= 0 || EnemyInternal <= 0)
		{
			return;
		}

		RoundNumber++;
		IsPlayerPhase = true;

		TryRecoverFromShutdown(isPlayer: true);
		var refreshedMovement = PlayerShutdown ? 0 : GetEffectiveMovement(UserMech, ActiveMovementMode, PlayerSections);
		if (IsComponentDestroyed(PlayerComponents, ComponentType.Engine))
			refreshedMovement = Math.Max(1, refreshedMovement - 2);

		UserMech = UserMech with { RemainingMovement = refreshedMovement, MaxMovement = refreshedMovement };
		PlayerHexesMovedThisTurn = 0;
		HasPlayerFiredThisTurn = false;
		UpdatePlayerFiringArc();
		AddConsoleLine($"Round {RoundNumber}");
	}

	private async Task<string> ExecuteEnemyTurn()
	{
		if (EnemyMech is null || UserMech is null)
			return "no action";

		if (PlayerInternal <= 0 || EnemyInternal <= 0)
			return "combat ended";

		var enemy = EnemyMech with
		{
			RemainingMovement = EnemyMech.WalkMp,
			MaxMovement = EnemyMech.WalkMp
		};

		LastEnemyAttackMessage = string.Empty;
		if (EnemyShutdown)
		{
			TryRecoverFromShutdown(isPlayer: false);
			if (EnemyShutdown)
			{
				ApplyHeatEndPhase(isPlayer: false);
				return "shutdown";
			}
		}

		var actions = new List<string>();
		var safety = 0;
		var movedHexes = 0;

		while (enemy.RemainingMovement > 0 && safety < 20)
		{
			safety++;
			var desiredFacing = GetDirectionToward(enemy.Column, enemy.Row, UserMech.Column, UserMech.Row);

			if (desiredFacing is not null && desiredFacing.Value != enemy.Facing)
			{
				var turnDelta = GetShortestTurnDelta(enemy.Facing, desiredFacing.Value);
				enemy = enemy with
				{
					Facing = NormalizeDirection((int)enemy.Facing + turnDelta),
					RemainingMovement = enemy.RemainingMovement - 1
				};
				EnemyHeat += 1;
				actions.Add("rotate");
				EnemyMech = enemy;
				await AnimateAiStep(300);
				continue;
			}

			var target = Step(enemy.Column, enemy.Row, enemy.Facing);
			if (!IsWithinMap(target.Column, target.Row) ||
				(target.Column == UserMech.Column && target.Row == UserMech.Row) ||
				!TileByCoordinate.TryGetValue((target.Column, target.Row), out var targetTile))
				break;

			TileByCoordinate.TryGetValue((enemy.Column, enemy.Row), out var enemyOriginTile);
			var cost = GetMoveCost(targetTile, true, MovementMode.Walk, enemyOriginTile);
			if (cost >= 99 || enemy.RemainingMovement < cost)
				break;

			enemy = enemy with
			{
				Column = target.Column,
				Row = target.Row,
				RemainingMovement = enemy.RemainingMovement - cost
			};
			movedHexes++;
			EnemyHeat += GetMovementHeat(MovementMode.Walk);
			actions.Add("move");
			EnemyMech = enemy;
			await AnimateAiStep(350);
		}

		EnemyMech = enemy;
		EnemyHexesMovedLastTurn = movedHexes;

		var rotations = actions.Count(a => a == "rotate");
		var moveSummaryParts = new List<string>();
		if (movedHexes > 0) moveSummaryParts.Add($"moved {movedHexes} hex{(movedHexes == 1 ? "" : "es")}");
		if (rotations > 0) moveSummaryParts.Add($"rotated {rotations} time{(rotations == 1 ? "" : "s")}");
		var moveSummary = moveSummaryParts.Count > 0
			? $"Enemy {string.Join(", ", moveSummaryParts)} → ({enemy.Column},{enemy.Row}) facing {enemy.Facing}."
			: $"Enemy held position at ({enemy.Column},{enemy.Row}).";
		AddConsoleLine(moveSummary);

		if (actions.Count > 0)
			await AnimateAiStep(400);

		var enemyArc = GetFrontArcTiles(enemy, 4);
		if (enemyArc.Contains((UserMech.Column, UserMech.Row)) && PlayerInternal > 0 && !IsArmDestroyed(EnemySections))
		{
			var range = CubeDistance(enemy.Column, enemy.Row, UserMech.Column, UserMech.Row);
			var rangeModifier = GetRangeModifier(range);
			if (rangeModifier < 99)
			{
				if (!CanFireBetween(enemy.Column, enemy.Row, UserMech.Column, UserMech.Row, out var enemyLosBlockedMessage, out var enemyTerrainModifier))
				{
					actions.Add(enemyLosBlockedMessage);
				}
				else
				{
					var operationalEnemyWeapons = GetOperationalWeapons(enemy.Weapons, EnemySections, EnemyComponents);
					if (operationalEnemyWeapons.Count == 0)
					{
						actions.Add("no operational weapons");
					}
					else
					{
						var firedWeapons = GetFiredWeapons(operationalEnemyWeapons, MovementMode.Walk);
					var enemyWeaponDamage = firedWeapons.Sum(w => w.Damage);
					var enemyWeaponHeat = firedWeapons.Sum(w => w.Heat);
					EnemyHeat += enemyWeaponHeat;
					var heatModifier = GetHeatToHitModifier(EnemyHeat);
					var enemyGyroModifier = IsComponentDestroyed(EnemyComponents, ComponentType.Gyro) ? 2 : 0;
					var enemyAttackerModifier = GetAttackerMovementModifier(MovementMode.Walk, movedHexes);
					var playerTargetModifier = GetTargetMovementModifier(PlayerHexesMovedThisTurn);
					var targetNumber = BaseToHit + rangeModifier + enemyAttackerModifier + playerTargetModifier + heatModifier + enemyGyroModifier + enemyTerrainModifier;
					var roll = Roll2d6();
					var modBreakdown = FormatModifierBreakdown(BaseToHit, rangeModifier, enemyAttackerModifier, playerTargetModifier, heatModifier, enemyGyroModifier, enemyTerrainModifier);
					var weaponLog = FormatWeaponList(firedWeapons);
					if (roll >= targetNumber)
					{
						var incomingArc = GetIncomingArc(UserMech.Facing, UserMech.Column, UserMech.Row, enemy.Column, enemy.Row);
						var hitLocation = RollHitLocation(incomingArc, Roll2d6());
						ApplyDamage(PlayerSections, hitLocation, enemyWeaponDamage, out var armorDamage, out var internalDamage, out var transferredToCt);
						var critMsg = string.Empty;
						if (internalDamage > 0)
							critMsg = RollCriticalHit(PlayerComponents, hitLocation);
						var impactDetail = BuildImpactDamageText(hitLocation, armorDamage, internalDamage);
						await PlayShotAnimation(attackerIsPlayer: false, targetIsPlayer: true, hit: true, impactDetail: impactDetail);
						RecalculateDurabilityTotals();
						var finalEnemyAttackMessage = $"Enemy HIT — {weaponLog} fired; rolled {roll} vs TN {targetNumber} ({modBreakdown}). {incomingArc} arc → {FormatLocation(hitLocation)}: {armorDamage} armor / {internalDamage} internal.";
						if (!string.IsNullOrWhiteSpace(critMsg))
							finalEnemyAttackMessage += $" {critMsg}";
						if (transferredToCt > 0)
							finalEnemyAttackMessage += $" +{transferredToCt} overflow to Center Torso.";
						if (PlayerInternal <= 0 || PlayerSections[HitLocation.CenterTorso].Internal <= 0 || PlayerSections[HitLocation.Head].Internal <= 0)
							finalEnemyAttackMessage += " Your mech was destroyed.";

						CheckGameOver();
						if (IsGameOver)
						{
							AddConsoleLine(finalEnemyAttackMessage);
							_lastActionMessage = finalEnemyAttackMessage;
							LastEnemyAttackMessage = string.Empty;
							actions.Add("player destroyed");
							return string.Join(", ", actions);
						}
						actions.Add($"hit ({roll}/{targetNumber})");
						LastEnemyAttackMessage = finalEnemyAttackMessage;
					}
					else
					{
						await PlayShotAnimation(attackerIsPlayer: false, targetIsPlayer: true, hit: false, impactDetail: null);
						actions.Add($"miss ({roll}/{targetNumber})");
						LastEnemyAttackMessage = $"Enemy MISS — {weaponLog} fired; rolled {roll} vs TN {targetNumber} ({modBreakdown}).";
					}
					}
				}
			}
		}

		ApplyHeatEndPhase(isPlayer: false);
		CheckGameOver();
		if (IsGameOver)
		{
			if (PlayerInternal <= 0)
			{
				actions.Add("player destroyed");
			}
			return actions.Count == 0 ? "combat ended" : string.Join(", ", actions);
		}

		if (PlayerInternal <= 0)
		{
			actions.Add("player destroyed");
			CheckGameOver();
		}

		return actions.Count == 0 ? "held position" : string.Join(", ", actions);
	}

	private void UpdatePlayerFiringArc()
	{
		PlayerFiringArcTiles.Clear();
		if (UserMech is null) return;
		foreach (var tile in GetFrontArcTiles(UserMech, 4))
			PlayerFiringArcTiles.Add(tile);
	}

	private HashSet<(int Column, int Row)> GetFrontArcTiles(PlayerMech mech, int range)
	{
		var arc = new HashSet<(int Column, int Row)>();
		if (CurrentMap is null) return arc;

		foreach (var tile in CurrentMap.Tiles)
		{
			if (tile.Column == mech.Column && tile.Row == mech.Row) continue;
			var distance = CubeDistance(mech.Column, mech.Row, tile.Column, tile.Row);
			if (distance == 0 || distance > range) continue;
			var bearing = GetDirectionToward(mech.Column, mech.Row, tile.Column, tile.Row);
			if (bearing is null) continue;
			if (GetDirectionDistance(mech.Facing, bearing.Value) <= 1)
				arc.Add((tile.Column, tile.Row));
		}

		return arc;
	}

	private bool IsTraversable(int column, int row)
	{
		if (!TileByCoordinate.TryGetValue((column, row), out var tile)) return false;
		return GetTerrainMoveCost(tile) < 99;
	}

	private bool IsWithinMap(int column, int row) =>
		CurrentMap is not null && column >= 0 && row >= 0 && column < CurrentMap.Width && row < CurrentMap.Height;

	private static HexDirection NormalizeDirection(int direction)
	{
		var normalized = ((direction % 6) + 6) % 6;
		return (HexDirection)normalized;
	}

	private static string GetTurnLabel(int delta) => delta < 0 ? "left" : "right";

	private static int GetMovementByClassAndMode(MechClass mechClass, MovementMode movementMode) => movementMode switch
	{
		MovementMode.Walk => mechClass switch { MechClass.Light => 6, MechClass.Medium => 5, MechClass.Heavy => 4, _ => 5 },
		MovementMode.Run  => mechClass switch { MechClass.Light => 8, MechClass.Medium => 7, MechClass.Heavy => 6, _ => 7 },
		MovementMode.Jump => mechClass switch { MechClass.Light => 5, MechClass.Medium => 4, MechClass.Heavy => 3, _ => 4 },
		_ => 5
	};

	private static int GetMechMpByMode(MechDefinition def, MovementMode mode) => mode switch
	{
		MovementMode.Walk => def.WalkSpeed,
		MovementMode.Run  => def.RunSpeed,
		MovementMode.Jump => def.JumpSpeed,
		_ => def.WalkSpeed
	};

	private static int GetMechMpByMode(PlayerMech mech, MovementMode mode) => mode switch
	{
		MovementMode.Walk => mech.WalkMp,
		MovementMode.Run  => mech.RunMp,
		MovementMode.Jump => mech.JumpMp,
		_ => mech.WalkMp
	};

	private int GetEffectiveMovement(PlayerMech mech, MovementMode mode, Dictionary<HitLocation, SectionState> sections)
	{
		var baseMovement = GetMechMpByMode(mech, mode);
		var leftLegDestroyed = sections[HitLocation.LeftLeg].Internal <= 0;
		var rightLegDestroyed = sections[HitLocation.RightLeg].Internal <= 0;
		if (leftLegDestroyed && rightLegDestroyed) return 0;
		if (leftLegDestroyed || rightLegDestroyed) return Math.Max(0, baseMovement - 2);
		return baseMovement;
	}

	private static int GetMovementHeat(MovementMode mode) => mode switch
	{
		MovementMode.Walk => 1, MovementMode.Run => 2, MovementMode.Jump => 3, _ => 1
	};

	private void AddPlayerHeat(int amount) => PlayerHeat = Math.Max(0, PlayerHeat + amount);

	private void TrySetMovementMode(MovementMode mode)
	{
		if (UserMech is null || IsGameOver) return;
		if (ActiveMovementMode == mode) return;

		if (mode == MovementMode.Jump && UserMech.JumpMp == 0)
		{
			LastActionMessage = $"{UserMech.MechName} has no jump jets.";
			return;
		}

		if (UserMech.RemainingMovement != UserMech.MaxMovement)
		{
			LastActionMessage = "You can only change movement mode before spending movement this turn.";
			return;
		}

		ActiveMovementMode = mode;
		var resetMovement = GetMechMpByMode(UserMech, ActiveMovementMode);
		UserMech = UserMech with { RemainingMovement = resetMovement, MaxMovement = resetMovement };
		LastActionMessage = $"Movement mode set to {ActiveMovementMode}.";
	}

	private string GetModeButtonClass(MovementMode mode) =>
		mode == ActiveMovementMode ? "btn-primary" : "btn-outline-primary";

	private void TryRotate(int directionDelta)
	{
		if (UserMech is null || IsGameOver) return;
		if (UserMech.RemainingMovement <= 0)
		{
			LastActionMessage = "No movement left this turn. End turn to continue.";
			return;
		}
		var nextFacing = NormalizeDirection((int)UserMech.Facing + directionDelta);
		UserMech = UserMech with { Facing = nextFacing, RemainingMovement = UserMech.RemainingMovement - 1 };
		AddPlayerHeat(1);
		UpdatePlayerFiringArc();
		LastActionMessage = $"Rotated {GetTurnLabel(directionDelta)} to {UserMech.Facing}.";
	}

	private void TryMove(bool forward)
	{
		if (UserMech is null || CurrentMap is null || IsGameOver) return;

		var heading = forward ? UserMech.Facing : NormalizeDirection((int)UserMech.Facing + 3);
		var destination = Step(UserMech.Column, UserMech.Row, heading);

		if (!IsWithinMap(destination.Column, destination.Row)) { LastActionMessage = "Cannot move outside the map."; return; }
		if (EnemyMech is not null && destination.Column == EnemyMech.Column && destination.Row == EnemyMech.Row) { LastActionMessage = "Destination occupied by enemy mech."; return; }
		if (!TileByCoordinate.TryGetValue((destination.Column, destination.Row), out var destinationTile)) { LastActionMessage = "Destination terrain could not be resolved."; return; }

		TileByCoordinate.TryGetValue((UserMech.Column, UserMech.Row), out var originTile);
		var moveCost = GetMoveCost(destinationTile, forward, ActiveMovementMode, originTile);
		if (moveCost >= 99) { LastActionMessage = $"{TerrainCatalog.GetLabel(destinationTile.Terrain)} is impassable in {ActiveMovementMode} mode."; return; }
		if (UserMech.RemainingMovement < moveCost) { LastActionMessage = $"Need {moveCost} movement, only {UserMech.RemainingMovement} remaining."; return; }

		UserMech = UserMech with { Column = destination.Column, Row = destination.Row, RemainingMovement = UserMech.RemainingMovement - moveCost };
		PlayerHexesMovedThisTurn++;
		AddPlayerHeat(GetMovementHeat(ActiveMovementMode));
		UpdatePlayerFiringArc();
		LastActionMessage = $"Moved {(forward ? "forward" : "backward")} in {ActiveMovementMode} mode into {TerrainCatalog.GetLabel(destinationTile.Terrain)} ({moveCost} MP).";
	}

	private void HandleBattlefieldKey(KeyboardEventArgs args)
	{
		if (UserMech is null) return;

		switch (args.Key)
		{
			case "1": case "Numpad1": case "w": case "W": TrySetMovementMode(MovementMode.Walk); return;
			case "2": case "Numpad2": case "r": case "R": TrySetMovementMode(MovementMode.Run); return;
			case "3": case "Numpad3": case "j": case "J": TrySetMovementMode(MovementMode.Jump); return;
			case "f": case "F": case " ": _ = ResolvePlayerAttack(); return;
		}

		if (!IsPlayerPhase) { LastActionMessage = "Wait for enemy phase to finish."; return; }
		if (IsGameOver) return;
		if (PlayerShutdown) { LastActionMessage = "Your mech is shutdown. End turn to attempt restart."; return; }
		if (PlayerInternal <= 0 || EnemyInternal <= 0) return;

		switch (args.Key)
		{
			case "ArrowLeft":  TryRotate(1); break;
			case "ArrowRight": TryRotate(-1); break;
			case "ArrowUp":    TryMove(true); break;
			case "ArrowDown":  TryMove(false); break;
		}
	}

	private void InitializeSections(Dictionary<HitLocation, SectionState> sections, MechDefinition def)
	{
		sections.Clear();
		// Internal structure per location follows BattleTech rules: based on tonnage
		// Allocation: Head=3, CT=floor(tonnage/10), each side torso=floor(CT*0.5 rounded up),
		// each arm=floor(CT*0.5 rounded down), each leg=floor(CT*0.5 rounded up... actually exact BT table)
		// We derive from tonnage using the official IS table.
		var tonnage = def.Tonnage;
		var ctInternal = (int)Math.Ceiling(tonnage / 10.0);
		var stInternal = (int)Math.Ceiling(ctInternal * 0.5);
		var armInternal = (int)Math.Floor(ctInternal * 0.5);
		var legInternal = ctInternal;
		var headInternal = 3;

		// Distribute TotalArmor across sections by canonical BattleTech weight ratios.
		// Ratios (out of total points): Head 1, CT 3, each ST 2, each Arm 1.5, each Leg 2
		// Total ratio units = 1 + 3 + 2+2 + 1.5+1.5 + 2+2 = 15
		var total = def.TotalArmor;
		var unit = total / 15.0;

		sections[HitLocation.Head]        = new((int)Math.Round(unit * 1),   headInternal);
		sections[HitLocation.CenterTorso] = new((int)Math.Round(unit * 3),   ctInternal);
		sections[HitLocation.LeftTorso]   = new((int)Math.Round(unit * 2),   stInternal);
		sections[HitLocation.RightTorso]  = new((int)Math.Round(unit * 2),   stInternal);
		sections[HitLocation.LeftArm]     = new((int)Math.Round(unit * 1.5), armInternal);
		sections[HitLocation.RightArm]    = new((int)Math.Round(unit * 1.5), armInternal);
		sections[HitLocation.LeftLeg]     = new((int)Math.Round(unit * 2),   legInternal);
		sections[HitLocation.RightLeg]    = new((int)Math.Round(unit * 2),   legInternal);
	}

	private static SectionState ScaleSection(int armor, int internalStructure, double scale) =>
		new((int)Math.Round(armor * scale), (int)Math.Round(internalStructure * scale));

	private void RecalculateDurabilityTotals()
	{
		PlayerArmor = PlayerSections.Values.Sum(part => Math.Max(0, part.Armor));
		PlayerInternal = PlayerSections.Values.Sum(part => Math.Max(0, part.Internal));
		EnemyArmor = EnemySections.Values.Sum(part => Math.Max(0, part.Armor));
		EnemyInternal = EnemySections.Values.Sum(part => Math.Max(0, part.Internal));
	}

	private static AttackArc GetIncomingArc(HexDirection targetFacing, int targetColumn, int targetRow, int attackerColumn, int attackerRow)
	{
		var bearing = GetDirectionToward(targetColumn, targetRow, attackerColumn, attackerRow);
		if (bearing is null) return AttackArc.Front;
		var clockwise = (((int)bearing.Value - (int)targetFacing) + 6) % 6;
		return clockwise switch { 0 or 1 or 5 => AttackArc.Front, 2 => AttackArc.RightSide, 4 => AttackArc.LeftSide, 3 => AttackArc.Rear, _ => AttackArc.Front };
	}

	private static HitLocation RollHitLocation(AttackArc arc, int roll) => arc switch
	{
		AttackArc.Rear => roll switch { <= 2 => HitLocation.CenterTorso, <= 4 => HitLocation.RightTorso, <= 6 => HitLocation.RightArm, <= 8 => HitLocation.CenterTorso, <= 10 => HitLocation.LeftTorso, <= 11 => HitLocation.LeftArm, _ => HitLocation.Head },
		AttackArc.LeftSide => roll switch { <= 2 => HitLocation.LeftLeg, <= 4 => HitLocation.LeftArm, <= 6 => HitLocation.LeftTorso, <= 8 => HitLocation.CenterTorso, <= 10 => HitLocation.RightTorso, <= 11 => HitLocation.RightArm, _ => HitLocation.Head },
		AttackArc.RightSide => roll switch { <= 2 => HitLocation.RightLeg, <= 4 => HitLocation.RightArm, <= 6 => HitLocation.RightTorso, <= 8 => HitLocation.CenterTorso, <= 10 => HitLocation.LeftTorso, <= 11 => HitLocation.LeftArm, _ => HitLocation.Head },
		_ => roll switch { <= 2 => HitLocation.CenterTorso, <= 4 => HitLocation.RightArm, <= 6 => HitLocation.RightTorso, <= 8 => HitLocation.CenterTorso, <= 10 => HitLocation.LeftTorso, <= 11 => HitLocation.LeftArm, _ => HitLocation.Head }
	};

	private static string FormatLocation(HitLocation location) => location switch
	{
		HitLocation.CenterTorso => "Center Torso", HitLocation.LeftTorso => "Left Torso", HitLocation.RightTorso => "Right Torso",
		HitLocation.LeftArm => "Left Arm", HitLocation.RightArm => "Right Arm", HitLocation.LeftLeg => "Left Leg", HitLocation.RightLeg => "Right Leg", _ => "Head"
	};

	private static void ApplyDamage(Dictionary<HitLocation, SectionState> sections, HitLocation location, int damage, out int armorDamage, out int internalDamage, out int transferredToCenterTorso)
	{
		armorDamage = 0; internalDamage = 0; transferredToCenterTorso = 0;
		if (!sections.TryGetValue(location, out var section)) return;
		armorDamage = Math.Min(section.Armor, damage);
		var remaining = damage - armorDamage;
		var updatedArmor = section.Armor - armorDamage;
		internalDamage = Math.Min(section.Internal, remaining);
		remaining -= internalDamage;
		sections[location] = section with { Armor = updatedArmor, Internal = section.Internal - internalDamage };
		if (remaining > 0 && location != HitLocation.CenterTorso && sections.TryGetValue(HitLocation.CenterTorso, out var ct))
		{
			var ctDamage = Math.Min(ct.Internal, remaining);
			sections[HitLocation.CenterTorso] = ct with { Internal = ct.Internal - ctDamage };
			internalDamage += ctDamage;
			transferredToCenterTorso = ctDamage;
		}
	}

	private void ApplyHeatEndPhase(bool isPlayer)
	{
		if (isPlayer)
		{
			PlayerHeat = Math.Max(0, PlayerHeat - HeatSinkValue);
			if (PlayerAmmoIntact && PlayerHeat >= 19 && Roll2d6() <= 4)
			{
				PlayerAmmoIntact = false;
				ApplyDamage(PlayerSections, HitLocation.CenterTorso, 10, out _, out _, out _);
				RecalculateDurabilityTotals();
				LastActionMessage = "Ammo explosion! Player center torso takes critical damage.";
			}
			if (GetShutdownTargetNumber(PlayerHeat) is int playerShutdownTarget && Roll2d6() < playerShutdownTarget)
				PlayerShutdown = true;
			return;
		}
		EnemyHeat = Math.Max(0, EnemyHeat - HeatSinkValue);
		if (EnemyAmmoIntact && EnemyHeat >= 19 && Roll2d6() <= 4)
		{
			EnemyAmmoIntact = false;
			ApplyDamage(EnemySections, HitLocation.CenterTorso, 10, out _, out _, out _);
			RecalculateDurabilityTotals();
			LastEnemyAttackMessage = "Enemy ammo explosion damages its center torso.";
		}
		if (GetShutdownTargetNumber(EnemyHeat) is int enemyShutdownTarget && Roll2d6() < enemyShutdownTarget)
			EnemyShutdown = true;
	}

	private void TryRecoverFromShutdown(bool isPlayer)
	{
		if (isPlayer) { if (!PlayerShutdown) return; if (Roll2d6() >= 6) PlayerShutdown = false; return; }
		if (!EnemyShutdown) return;
		if (Roll2d6() >= 6) EnemyShutdown = false;
	}

	private static int? GetShutdownTargetNumber(int heat) => heat switch
	{
		>= 30 => 12, >= 26 => 10, >= 22 => 8, >= 18 => 6, >= 14 => 4, _ => null
	};

	private static void InitializeComponents(Dictionary<HitLocation, List<ComponentStatus>> components)
	{
		components.Clear();
		components[HitLocation.Head] = new();
		components[HitLocation.CenterTorso] = new() { new(ComponentType.Engine, false), new(ComponentType.Gyro, false) };
		components[HitLocation.LeftTorso] = new() { new(ComponentType.Weapon, false) };
		components[HitLocation.RightTorso] = new() { new(ComponentType.Weapon, false) };
		components[HitLocation.LeftArm] = new() { new(ComponentType.Weapon, false) };
		components[HitLocation.RightArm] = new() { new(ComponentType.Weapon, false) };
		components[HitLocation.LeftLeg] = new() { new(ComponentType.JumpJet, false), new(ComponentType.JumpJet, false) };
		components[HitLocation.RightLeg] = new() { new(ComponentType.JumpJet, false), new(ComponentType.JumpJet, false) };
	}

	private string RollCriticalHit(Dictionary<HitLocation, List<ComponentStatus>> components, HitLocation location)
	{
		if (!components.TryGetValue(location, out var parts) || parts.Count == 0) return string.Empty;
		var functional = parts.Where(p => !p.IsDestroyed).ToList();
		if (functional.Count == 0) return string.Empty;
		var roll = Roll2d6();
		if (roll < CriticalHitThreshold) return string.Empty;
		var targetIndex = Random.Shared.Next(0, functional.Count);
		var targetComponent = functional[targetIndex];
		var partIndex = parts.IndexOf(targetComponent);
		parts[partIndex] = targetComponent with { IsDestroyed = true };
		return $"CRITICAL! {FormatLocation(location)} {FormatComponentType(targetComponent.Type)} destroyed!";
	}

	private static bool IsComponentDestroyed(Dictionary<HitLocation, List<ComponentStatus>> components, ComponentType type)
	{
		foreach (var parts in components.Values)
			foreach (var part in parts)
				if (part.Type == type && part.IsDestroyed) return true;
		return false;
	}

	private static bool IsArmDestroyed(Dictionary<HitLocation, SectionState> sections) =>
		sections[HitLocation.LeftArm].Internal <= 0 && sections[HitLocation.RightArm].Internal <= 0;

	private string BuildPlayerMechTooltip()
	{
		if (UserMech is null) return string.Empty;
		return BuildMechTooltip("Player", UserMech, PlayerSections, PlayerMaxSections, PlayerComponents, PlayerHeat, PlayerShutdown, PlayerAmmoIntact, ActiveMovementMode);
	}

	private string BuildEnemyMechTooltip()
	{
		if (EnemyMech is null) return string.Empty;
		return BuildMechTooltip("Enemy", EnemyMech, EnemySections, EnemyMaxSections, EnemyComponents, EnemyHeat, EnemyShutdown, EnemyAmmoIntact, MovementMode.Walk);
	}

	private string BuildMechTooltip(string title, PlayerMech mech, Dictionary<HitLocation, SectionState> sections, Dictionary<HitLocation, SectionState> maxSections, Dictionary<HitLocation, List<ComponentStatus>> components, int heat, bool shutdown, bool ammoIntact, MovementMode mode)
	{
		TileByCoordinate.TryGetValue((mech.Column, mech.Row), out var occupiedTile);
		var terrainContext = occupiedTile is null ? "Unknown" : BuildTileContext(occupiedTile);
		var lines = new List<string>
		{
			$"{title} {mech.MechName}",
			$"Facing: {mech.Facing} | Hex: ({mech.Column}, {mech.Row}) {terrainContext}",
			$"Mode: {mode} | Movement: {mech.RemainingMovement}/{mech.MaxMovement}",
			$"Heat: {heat} | Status: {(shutdown ? "Shutdown" : "Online")} | Ammo: {(ammoIntact ? "Safe" : "Exploded")}",
			"Sections (Armour / Internal):"
		};

		foreach (var location in Enum.GetValues<HitLocation>())
		{
			if (!sections.TryGetValue(location, out var current)) continue;
			maxSections.TryGetValue(location, out var maxSection);
			var armorPercent = GetPercent(Math.Max(0, current.Armor), maxSection.Armor);
			var internalPercent = GetPercent(Math.Max(0, current.Internal), maxSection.Internal);
			var armorBar = BuildRetroBar(armorPercent);
			var internalBar = BuildRetroBar(internalPercent);
			lines.Add($"- {GetShortLocationLabel(location),-8} A {armorBar} {armorPercent,3}% | I {internalBar} {internalPercent,3}%");
		}

		var criticalLines = new List<string>();
		foreach (var (location, parts) in components)
			foreach (var part in parts.Where(p => p.IsDestroyed))
				criticalLines.Add($"{GetShortLocationLabel(location)} {FormatComponentType(part.Type)}");
		lines.Add(criticalLines.Count == 0 ? "Critical damage: None" : $"Critical damage: {string.Join(", ", criticalLines)}");

		if (mech.Weapons is not null && mech.Weapons.Count > 0)
		{
			lines.Add("Weapons:");
			var weaponsByLocation = mech.Weapons.GroupBy(w => w.Location).OrderBy(g => g.Key.ToString());
			foreach (var group in weaponsByLocation)
			{
				var location = group.Key;
				var locationLabel = GetShortLocationLabel(location);
				
				var destroyedWeaponSlots = 0;
				if (components.TryGetValue(location, out var parts))
				{
					destroyedWeaponSlots = parts.Count(p => p.Type == ComponentType.Weapon && p.IsDestroyed);
				}

				var weaponStrings = new List<string>();
				var locationWeapons = group.ToList();
				for (var i = 0; i < locationWeapons.Count; i++)
				{
					var w = locationWeapons[i];
					var weaponStr = $"{w.Name}({w.Damage}dmg/{w.Heat}ht)";
					if (i >= locationWeapons.Count - destroyedWeaponSlots)
					{
						weaponStr = $"~~{weaponStr}~~";
					}
					weaponStrings.Add(weaponStr);
				}
				
				lines.Add($"- {locationLabel,-8} {string.Join(", ", weaponStrings)}");
			}
		}

		return string.Join("\n", lines);
	}

	private SectionState GetMaxSectionForClass(MechClass mechClass, HitLocation location)
	{
		var scale = mechClass switch { MechClass.Light => 0.8, MechClass.Medium => 1.0, MechClass.Heavy => 1.3, _ => 1.0 };
		return location switch
		{
			HitLocation.Head => ScaleSection(3, 3, scale),
			HitLocation.CenterTorso => ScaleSection(10, 8, scale),
			HitLocation.LeftTorso => ScaleSection(8, 6, scale),
			HitLocation.RightTorso => ScaleSection(8, 6, scale),
			HitLocation.LeftArm => ScaleSection(6, 4, scale),
			HitLocation.RightArm => ScaleSection(6, 4, scale),
			HitLocation.LeftLeg => ScaleSection(8, 6, scale),
			HitLocation.RightLeg => ScaleSection(8, 6, scale),
			_ => ScaleSection(1, 1, scale)
		};
	}

	private static int GetPercent(int current, int max) =>
		max <= 0 ? 0 : Math.Clamp((int)Math.Round((current / (double)max) * 100), 0, 100);

	private static string BuildRetroBar(int percent)
	{
		var filled = Math.Clamp((int)Math.Round(percent / 10.0), 0, 10);
		return new string('█', filled) + new string('░', 10 - filled);
	}

	private static string GetShortLocationLabel(HitLocation location) => location switch
	{
		HitLocation.Head => "Head", HitLocation.CenterTorso => "C Torso", HitLocation.LeftTorso => "L Torso",
		HitLocation.RightTorso => "R Torso", HitLocation.LeftArm => "L Arm", HitLocation.RightArm => "R Arm",
		HitLocation.LeftLeg => "L Leg", HitLocation.RightLeg => "R Leg", _ => "Unknown"
	};

	private static string BuildTileContext(HexTile tile)
	{
		if (tile.HillLevel is int hillLevel) return $"{TerrainCatalog.GetLabel(tile.Terrain)} Level {hillLevel}";
		if (tile.WaterDepth is int waterDepth) return $"{TerrainCatalog.GetLabel(tile.Terrain)} Depth {waterDepth}";
		return TerrainCatalog.GetLabel(tile.Terrain);
	}

	private static string FormatComponentType(ComponentType type) => type switch
	{
		ComponentType.Engine => "Engine", ComponentType.Gyro => "Gyro", ComponentType.Weapon => "Weapon", ComponentType.JumpJet => "JumpJet", _ => "Unknown"
	};

	private void CheckGameOver()
	{
		if (PlayerSections[HitLocation.CenterTorso].Internal <= 0) { SetGameOver(false, "Your Center Torso destroyed! Engine destroyed! Mech destroyed!", "Center Torso destroyed!"); return; }
		if (EnemySections[HitLocation.CenterTorso].Internal <= 0) { SetGameOver(true, "Enemy Center Torso destroyed! Engine destroyed! Enemy mech destroyed!", "Center Torso destroyed!"); return; }
		if (PlayerSections[HitLocation.LeftTorso].Internal <= 0 && PlayerSections[HitLocation.RightTorso].Internal <= 0) { SetGameOver(false, "Both side torsos destroyed! Structural failure! Mech destroyed!", "Both torsos destroyed!"); return; }
		if (EnemySections[HitLocation.LeftTorso].Internal <= 0 && EnemySections[HitLocation.RightTorso].Internal <= 0) { SetGameOver(true, "Enemy both side torsos destroyed! Structural failure! Enemy mech destroyed!", "Both torsos destroyed!"); return; }
		if (PlayerSections[HitLocation.Head].Internal <= 0) { SetGameOver(false, "Your Head destroyed! Pilot dead! Mech destroyed!", "Head destroyed!"); return; }
		if (EnemySections[HitLocation.Head].Internal <= 0) { SetGameOver(true, "Enemy Head destroyed! Enemy pilot dead! Enemy mech destroyed!", "Head destroyed!"); return; }
		if (PlayerInternal <= 0) { IsGameOver = true; PlayerWon = false; ShowGameOverOverlay = true; }
		else if (EnemyInternal <= 0) { IsGameOver = true; PlayerWon = true; ShowGameOverOverlay = true; }
	}

	private void SetGameOver(bool playerWon, string message, string overlayMsg)
	{
		IsGameOver = true;
		PlayerWon = playerWon;
		ShowGameOverOverlay = true;
		LastActionMessage = message;
		ShowDestructionOverlay(!playerWon, overlayMsg);
	}

	private void ShowDestructionOverlay(bool isPlayer, string message)
	{
		if (isPlayer) { PlayerImpactText = message; PlayerImpactIsDestruction = true; PlayerImpactIsHit = false; PlayerImpactDamageText = null; }
		else { EnemyImpactText = message; EnemyImpactIsDestruction = true; EnemyImpactIsHit = false; EnemyImpactDamageText = null; }
	}

	private void DismissGameOverOverlay()
	{
		ShowGameOverOverlay = false;
	}

	private void GoToNewGame()
	{
		Nav.NavigateTo("/");
	}

	private void AddConsoleLine(string? line)
	{
		if (string.IsNullOrWhiteSpace(line)) return;
		var entry = PrefixConsoleLine(line);
		if (CombatLog.Count > 0 && CombatLog[^1] == entry) return;
		CombatLog.Add(entry);
		if (CombatLog.Count > 120) CombatLog.RemoveAt(0);
		ShouldAutoScrollConsole = true;
	}

	private static string PrefixConsoleLine(string line)
	{
		if (line.StartsWith("[Enemy] ", StringComparison.OrdinalIgnoreCase) ||
			line.StartsWith("[Allied] ", StringComparison.OrdinalIgnoreCase) ||
			line.StartsWith("Round ", StringComparison.OrdinalIgnoreCase))
			return line;
		return IsEnemyActionLine(line) ? $"[Enemy] {line}" : $"[Allied] {line}";
	}

	private static bool IsEnemyActionLine(string line) => line.StartsWith("Enemy ", StringComparison.OrdinalIgnoreCase);

	private static ConsoleLineParts ParseConsoleLine(string line)
	{
		if (line.StartsWith("[Enemy] ", StringComparison.OrdinalIgnoreCase)) return new("[Enemy] ", line.Substring(8));
		if (line.StartsWith("[Allied] ", StringComparison.OrdinalIgnoreCase)) return new("[Allied] ", line.Substring(9));
		return new(null, line);
	}

	private static LogEntryType ClassifyLogLine(string line)
	{
		var content = ParseConsoleLine(line).Message;
		if (content.Contains("CRITICAL", StringComparison.OrdinalIgnoreCase) || content.Contains("destroyed", StringComparison.OrdinalIgnoreCase) || content.Contains("explosion", StringComparison.OrdinalIgnoreCase)) return LogEntryType.Destruction;
		if (content.StartsWith("HIT", StringComparison.OrdinalIgnoreCase) || content.StartsWith("Enemy HIT", StringComparison.OrdinalIgnoreCase)) return LogEntryType.Hit;
		if (content.StartsWith("MISS", StringComparison.OrdinalIgnoreCase) || content.StartsWith("Enemy MISS", StringComparison.OrdinalIgnoreCase)) return LogEntryType.Miss;
		return LogEntryType.Normal;
	}

	private static string GetLogCssClass(string line) => ClassifyLogLine(line) switch
	{
		_ when line.StartsWith("Round ", StringComparison.OrdinalIgnoreCase) => "log-round",
		LogEntryType.Hit => "log-hit",
		LogEntryType.Miss => "log-miss",
		LogEntryType.Destruction => "log-destruction",
		_ => string.Empty
	};

	private static string GetPrefixCssClass(string? prefix) => prefix switch
	{
		"[Enemy]" => "log-prefix-enemy", "[Allied]" => "log-prefix-allied", _ => string.Empty
	};

	private static int GetArmorByClass(MechClass mechClass) => mechClass switch { MechClass.Light => 18, MechClass.Medium => 28, MechClass.Heavy => 40, _ => 28 };
	private static int GetInternalByClass(MechClass mechClass) => mechClass switch { MechClass.Light => 12, MechClass.Medium => 18, MechClass.Heavy => 24, _ => 18 };

	private static int GetRangeModifier(int range) => range switch { <= 3 => 0, <= 6 => 2, <= MaxWeaponRange => 4, _ => 99 };

	private static int GetAttackerMovementModifier(MovementMode mode, int hexesMoved)
	{
		if (hexesMoved <= 0) return 0;
		return mode switch { MovementMode.Walk => 1, MovementMode.Run => 2, MovementMode.Jump => 3, _ => 1 };
	}

	private static int GetHeatToHitModifier(int heat) => heat switch { >= 17 => 3, >= 13 => 2, >= 8 => 1, _ => 0 };
	private static int GetTargetMovementModifier(int hexesMoved) => hexesMoved switch { <= 0 => 0, <= 2 => 1, <= 4 => 2, <= 6 => 3, _ => 4 };

	private static string FormatModifierBreakdown(int baseTn, int range, int attackerMove, int targetMove, int heat, int gyro, int terrain)
	{
		var parts = new List<string> { $"base {baseTn}" };
		if (range != 0)        parts.Add($"range {range:+#;-#;0}");
		if (attackerMove != 0) parts.Add($"attacker move {attackerMove:+#;-#;0}");
		if (targetMove != 0)   parts.Add($"target move {targetMove:+#;-#;0}");
		if (heat != 0)         parts.Add($"heat {heat:+#;-#;0}");
		if (gyro != 0)         parts.Add($"gyro {gyro:+#;-#;0}");
		if (terrain != 0)      parts.Add($"cover {terrain:+#;-#;0}");
		return string.Join(", ", parts);
	}

	private static int Roll2d6() => Random.Shared.Next(1, 7) + Random.Shared.Next(1, 7);

	private int GetMoveCost(HexTile destinationTile, bool forward, MovementMode movementMode, HexTile? originTile)
	{
		if (movementMode == MovementMode.Jump) return 1;
		var baseCost = GetTerrainMoveCost(destinationTile);
		if (baseCost >= 99) return baseCost;
		var originLevel = GetTileLevel(originTile);
		var destinationLevel = GetTileLevel(destinationTile);
		var climbCost = Math.Max(0, destinationLevel - originLevel);
		return baseCost + climbCost + (forward ? 0 : 1);
	}

	private static int GetTerrainMoveCost(HexTile tile)
	{
		if (tile.Terrain == TerrainType.Mountains) return 99;
		if (tile.Terrain == TerrainType.Water) return tile.WaterDepth switch { 1 => 2, 2 => 3, 3 => 4, _ => 2 };
		return tile.Terrain switch
		{
			TerrainType.Plains or TerrainType.Rock or TerrainType.Urban or TerrainType.Crater or TerrainType.Scrub or TerrainType.Sand or TerrainType.Ice => 1,
			TerrainType.Hills or TerrainType.Forest or TerrainType.Jungle or TerrainType.Canyon => 2,
			TerrainType.Swamp => 3, _ => 1
		};
	}

	private static int GetDefenseModifier(HexTile targetTile)
	{
		var modifier = 0;
		if (targetTile.HillLevel is >= 2) return 2;
		if (targetTile.HillLevel is 1) modifier += 1;
		if (targetTile.WaterDepth is >= 2) return modifier + 2;
		if (targetTile.WaterDepth is 1) modifier += 1;
		modifier += targetTile.Terrain switch
		{
			TerrainType.Forest => 1, TerrainType.Jungle => 1, TerrainType.Urban => 1, TerrainType.Canyon => 1,
			TerrainType.Swamp => 1, TerrainType.Crater => 1, TerrainType.Mountains => 2, _ => 0
		};
		return Math.Max(0, modifier);
	}

	private bool CanFireBetween(int attackerColumn, int attackerRow, int targetColumn, int targetRow, out string blockedMessage, out int terrainFiringModifier)
	{
		blockedMessage = string.Empty;
		terrainFiringModifier = 0;
		if (!TileByCoordinate.TryGetValue((attackerColumn, attackerRow), out var attackerTile) ||
			!TileByCoordinate.TryGetValue((targetColumn, targetRow), out var targetTile))
		{ blockedMessage = "No shot (terrain data unavailable)"; return false; }
		terrainFiringModifier = GetDefenseModifier(targetTile);
		if (IsLineBlockedByInterveningTerrain(attackerColumn, attackerRow, targetColumn, targetRow, attackerTile, targetTile))
		{ blockedMessage = "No shot (line of sight blocked by elevation)"; return false; }
		return true;
	}

	private bool IsLineBlockedByInterveningTerrain(int attackerColumn, int attackerRow, int targetColumn, int targetRow, HexTile attackerTile, HexTile targetTile)
	{
		var attackerLevel = GetTileLevel(attackerTile);
		var targetLevel = GetTileLevel(targetTile);
		var attackerSightLevel = attackerLevel + 2;
		var targetSightLevel = targetLevel + 2;
		var blockingThreshold = Math.Min(attackerSightLevel, targetSightLevel);
		foreach (var point in GetHexLine(attackerColumn, attackerRow, targetColumn, targetRow))
		{
			if ((point.Column == attackerColumn && point.Row == attackerRow) || (point.Column == targetColumn && point.Row == targetRow)) continue;
			if (!TileByCoordinate.TryGetValue((point.Column, point.Row), out var interveningTile)) continue;
			if (GetTileLevel(interveningTile) >= blockingThreshold) return true;
		}
		return false;
	}

	private static int GetTileLevel(HexTile? tile)
	{
		if (tile is null) return 0;
		if (tile.HillLevel is int hillLevel) return hillLevel;
		if (tile.WaterDepth is int waterDepth) return -waterDepth;
		return 0;
	}

	private static IEnumerable<(int Column, int Row)> GetHexLine(int columnA, int rowA, int columnB, int rowB)
	{
		var start = OddRToCube(columnA, rowA);
		var end = OddRToCube(columnB, rowB);
		var distance = CubeDistance(columnA, rowA, columnB, rowB);
		if (distance == 0) { yield return (columnA, rowA); yield break; }
		for (var step = 0; step <= distance; step++)
		{
			var t = step / (double)distance;
			yield return CubeToOddR(CubeRound(CubeLerp(start, end, t)));
		}
	}

	private static CubeD CubeLerp(Cube from, Cube to, double t) => new(from.X + ((to.X - from.X) * t), from.Y + ((to.Y - from.Y) * t), from.Z + ((to.Z - from.Z) * t));

	private static Cube CubeRound(CubeD cube)
	{
		var rx = (int)Math.Round(cube.X); var ry = (int)Math.Round(cube.Y); var rz = (int)Math.Round(cube.Z);
		var xDiff = Math.Abs(rx - cube.X); var yDiff = Math.Abs(ry - cube.Y); var zDiff = Math.Abs(rz - cube.Z);
		if (xDiff > yDiff && xDiff > zDiff) rx = -ry - rz;
		else if (yDiff > zDiff) ry = -rx - rz;
		else rz = -rx - ry;
		return new Cube(rx, ry, rz);
	}

	private static (int Column, int Row) CubeToOddR(Cube cube) { var row = cube.Z; return (cube.X + ((row - (row & 1)) / 2), row); }

	private static (int Column, int Row) Step(int column, int row, HexDirection direction)
	{
		var isEvenRow = row % 2 == 0;
		return direction switch
		{
			HexDirection.East => (column + 1, row),
			HexDirection.NorthEast => isEvenRow ? (column, row - 1) : (column + 1, row - 1),
			HexDirection.NorthWest => isEvenRow ? (column - 1, row - 1) : (column, row - 1),
			HexDirection.West => (column - 1, row),
			HexDirection.SouthWest => isEvenRow ? (column - 1, row + 1) : (column, row + 1),
			HexDirection.SouthEast => isEvenRow ? (column, row + 1) : (column + 1, row + 1),
			_ => (column, row)
		};
	}

	private static int GetShortestTurnDelta(HexDirection from, HexDirection to)
	{
		var clockwise = (((int)to - (int)from) + 6) % 6;
		var counterClockwise = (((int)from - (int)to) + 6) % 6;
		return clockwise <= counterClockwise ? 1 : -1;
	}

	private static int GetDirectionDistance(HexDirection a, HexDirection b)
	{
		var diff = Math.Abs((int)a - (int)b);
		return Math.Min(diff, 6 - diff);
	}

	private static HexDirection? GetDirectionToward(int fromColumn, int fromRow, int toColumn, int toRow)
	{
		if (fromColumn == toColumn && fromRow == toRow) return null;
		var origin = OddRToCube(fromColumn, fromRow);
		var target = OddRToCube(toColumn, toRow);
		var delta = new Cube(target.X - origin.X, target.Y - origin.Y, target.Z - origin.Z);
		var bestDirection = HexDirection.East;
		var bestDot = int.MinValue;
		foreach (var candidate in Enum.GetValues<HexDirection>())
		{
			var vector = GetCubeDirectionVector(candidate);
			var dot = (delta.X * vector.X) + (delta.Y * vector.Y) + (delta.Z * vector.Z);
			if (dot > bestDot) { bestDot = dot; bestDirection = candidate; }
		}
		return bestDirection;
	}

	private static Cube GetCubeDirectionVector(HexDirection direction) => direction switch
	{
		HexDirection.East => new Cube(1, -1, 0), HexDirection.NorthEast => new Cube(1, 0, -1),
		HexDirection.NorthWest => new Cube(0, 1, -1), HexDirection.West => new Cube(-1, 1, 0),
		HexDirection.SouthWest => new Cube(-1, 0, 1), HexDirection.SouthEast => new Cube(0, -1, 1),
		_ => new Cube(0, 0, 0)
	};

	private static int CubeDistance(int columnA, int rowA, int columnB, int rowB)
	{
		var a = OddRToCube(columnA, rowA);
		var b = OddRToCube(columnB, rowB);
		return Math.Max(Math.Abs(a.X - b.X), Math.Max(Math.Abs(a.Y - b.Y), Math.Abs(a.Z - b.Z)));
	}

	private static Cube OddRToCube(int column, int row)
	{
		var x = column - ((row - (row & 1)) / 2);
		var z = row;
		return new Cube(x, -x - z, z);
	}

	private readonly record struct Cube(int X, int Y, int Z);
	private readonly record struct CubeD(double X, double Y, double Z);

}
