	/// <summary>
	/// Builds a human-readable breakdown of all to-hit modifiers for the console log.
	/// Only includes non-zero modifiers so the output stays concise.
	/// </summary>
	private static string FormatModifierBreakdown(int baseTn, int range, int attackerMove, int targetMove, int heat, int gyro, int terrain)
	{
		var parts = new List<string> { $"base {baseTn}" };
		if (range != 0)        parts.Add($"range {range:+#;-#;0}");
		if (attackerMove != 0) parts.Add($"attacker move {attackerMove:+#;-#;0}");
		if (targetMove != 0)   parts.Add($"target move {targetMove:+#;-#;0}");
		if (heat != 0)         parts.Add($"heat {heat:+#;-#;0}");
		if (gyro != 0)         parts.Add($"gyro {gyro:+#;-#;0}");
		if (terrain != 0)      parts.Add($"cover {terrain:+#;-#;0}");
		return string.Join(", ", parts);
	}

	private static int Roll2d6() => Random.Shared.Next(1, 7) + Random.Shared.Next(1, 7);

	private int GetMoveCost(HexTile destinationTile, bool forward, MovementMode movementMode, HexTile? originTile)
	{
		if (movementMode == MovementMode.Jump)
		{
			return 1;
		}

		var baseCost = GetTerrainMoveCost(destinationTile);
		if (baseCost >= 99)
		{
			return baseCost;
		}

		var originLevel = GetTileLevel(originTile);
		var destinationLevel = GetTileLevel(destinationTile);
		var climbCost = Math.Max(0, destinationLevel - originLevel);

		return baseCost + climbCost + (forward ? 0 : 1);
	}

	private static int GetTerrainMoveCost(HexTile tile)
	{
		if (tile.Terrain == TerrainType.Mountains)
		{
			return 99;
		}

		if (tile.Terrain == TerrainType.Water)
		{
			return tile.WaterDepth switch
			{
				1 => 2,
				2 => 3,
				3 => 4,
				_ => 2
			};
		}

		return tile.Terrain switch
		{
			TerrainType.Plains or TerrainType.Rock or TerrainType.Urban or TerrainType.Crater or TerrainType.Scrub or TerrainType.Sand or TerrainType.Ice => 1,
			TerrainType.Hills or TerrainType.Forest or TerrainType.Jungle or TerrainType.Canyon => 2,
			TerrainType.Swamp => 3,
			_ => 1
		};
	}

	/// <summary>
	/// Calculates BattleTech defense modifiers based on target terrain/cover.
	/// Targets in cover/difficult terrain are harder to hit (higher target number).
	/// 
	/// BattleTech Rules:
	/// - Hills Level 1: +1 defense modifier (partial cover)
	/// - Hills Level 2+: +2 defense modifier (full cover)
	/// - Water Depth 1: +1 defense modifier (partially submerged)
	/// - Water Depth 2+: +2 defense modifier (mostly submerged/deep water)
	/// - Forest/Jungle: +1 defense modifier (partial cover from vegetation)
	/// - Urban: +1 defense modifier (target can use buildings for cover)
	/// - Canyon: +1 defense modifier (walls provide cover)
	/// 
	/// In BattleTech: Higher target number = harder to hit (defender gets better defense).
	/// So defensive terrain increases the target number that the attacker must roll.
	/// </summary>
	private static int GetDefenseModifier(HexTile targetTile)
	{
		var modifier = 0;

		// Hills provide elevation-based cover
		if (targetTile.HillLevel is >= 2)
		{
			return 2; // Full cover on high hills
		}

		if (targetTile.HillLevel is 1)
		{
			modifier += 1; // Partial cover on low hills
		}

		// Water provides concealment/cover
		if (targetTile.WaterDepth is >= 2)
		{
			return modifier + 2; // Mostly submerged is significant cover
		}

		if (targetTile.WaterDepth is 1)
		{
			modifier += 1; // Partially in water
		}

		// Vegetation and urban terrain provide concealment
		modifier += targetTile.Terrain switch
		{
			TerrainType.Forest => 1,        // Trees provide cover
			TerrainType.Jungle => 1,        // Dense vegetation
			TerrainType.Urban => 1,         // Buildings provide cover/concealment
			TerrainType.Canyon => 1,        // Canyon walls provide cover
			TerrainType.Swamp => 1,         // Water and vegetation combined
			TerrainType.Crater => 1,        // Crater rim provides partial cover
			TerrainType.Scrub => 0,         // Scrubland provides minimal cover
			TerrainType.Plains => 0,        // No cover
			TerrainType.Rock => 0,          // Exposed rock provides no cover
			TerrainType.Sand => 0,          // Desert provides no cover
			TerrainType.Ice => 0,           // Slippery but no cover
			TerrainType.Mountains => 2,     // Mountains = full cover (but shouldn't be targeted anyway)
			_ => 0
		};

		return Math.Max(0, modifier);
	}

	private bool CanFireBetween(
		int attackerColumn,
		int attackerRow,
		int targetColumn,
		int targetRow,
		out string blockedMessage,
		out int terrainFiringModifier)
	{
		blockedMessage = string.Empty;
		terrainFiringModifier = 0;

		if (!TileByCoordinate.TryGetValue((attackerColumn, attackerRow), out var attackerTile) ||
			!TileByCoordinate.TryGetValue((targetColumn, targetRow), out var targetTile))
		{
			blockedMessage = "No shot (terrain data unavailable)";
			return false;
		}

		// BattleTech Defense Modifiers: targets in cover/difficult terrain get DEFENSIVE BENEFITS
		// This REDUCES the target number (makes it easier to hit them... wait, that's backwards)
		// Actually: defensive = harder to hit, so we ADD to target number.
		// A mech in cover is harder to hit, so target number increases.
		// Example: mech on level 2 hill = TN increases by 2 (harder to hit)
		terrainFiringModifier = GetDefenseModifier(targetTile);

		if (IsLineBlockedByInterveningTerrain(attackerColumn, attackerRow, targetColumn, targetRow, attackerTile, targetTile))
		{
			blockedMessage = "No shot (line of sight blocked by elevation)";
			return false;
		}

		return true;
	}

	private bool IsLineBlockedByInterveningTerrain(
		int attackerColumn,
		int attackerRow,
		int targetColumn,
		int targetRow,
		HexTile attackerTile,
		HexTile targetTile)
	{
		var attackerLevel = GetTileLevel(attackerTile);
		var targetLevel = GetTileLevel(targetTile);
		
		// In BattleTech, a mech can see over terrain that is lower than itself.
		// Each elevation level represents half a mech's height.
		// An intervening hex blocks LOS if it is taller than BOTH the attacker and target.
		// Standard rule: intervening terrain must be higher than the observer to block LOS.
		var attackerSightLevel = attackerLevel + 2;  // Mech height = 2 elevation levels
		var targetSightLevel = targetLevel + 2;      // Mech height = 2 elevation levels
		var blockingThreshold = Math.Min(attackerSightLevel, targetSightLevel);

		foreach (var point in GetHexLine(attackerColumn, attackerRow, targetColumn, targetRow))
		{
			if ((point.Column == attackerColumn && point.Row == attackerRow) ||
				(point.Column == targetColumn && point.Row == targetRow))
			{
				continue;
			}

			if (!TileByCoordinate.TryGetValue((point.Column, point.Row), out var interveningTile))
			{
				continue;
			}

			var interveningLevel = GetTileLevel(interveningTile);
			// Intervening terrain blocks if it's taller than BOTH the attacker and target can see over.
			if (interveningLevel >= blockingThreshold)
			{
				return true;
			}
		}

		return false;
	}

	private static int GetTileLevel(HexTile? tile)
	{
		if (tile is null)
		{
			return 0;
		}

		if (tile.HillLevel is int hillLevel)
		{
			return hillLevel;
		}

		if (tile.WaterDepth is int waterDepth)
		{
			return -waterDepth;
		}

		return 0;
	}

	private static IEnumerable<(int Column, int Row)> GetHexLine(int columnA, int rowA, int columnB, int rowB)
	{
		var start = OddRToCube(columnA, rowA);
		var end = OddRToCube(columnB, rowB);
		var distance = CubeDistance(columnA, rowA, columnB, rowB);

		if (distance == 0)
		{
			yield return (columnA, rowA);
			yield break;
		}

		for (var step = 0; step <= distance; step++)
		{
			var t = step / (double)distance;
			var interpolated = CubeLerp(start, end, t);
			var rounded = CubeRound(interpolated);
			yield return CubeToOddR(rounded);
		}
	}

	private static CubeD CubeLerp(Cube from, Cube to, double t) => new(
		from.X + ((to.X - from.X) * t),
		from.Y + ((to.Y - from.Y) * t),
		from.Z + ((to.Z - from.Z) * t));

	private static Cube CubeRound(CubeD cube)
	{
		var rx = (int)Math.Round(cube.X);
		var ry = (int)Math.Round(cube.Y);
		var rz = (int)Math.Round(cube.Z);

		var xDiff = Math.Abs(rx - cube.X);
		var yDiff = Math.Abs(ry - cube.Y);
		var zDiff = Math.Abs(rz - cube.Z);

		if (xDiff > yDiff && xDiff > zDiff)
		{
			rx = -ry - rz;
		}
		else if (yDiff > zDiff)
		{
			ry = -rx - rz;
		}
		else
		{
			rz = -rx - ry;
		}

		return new Cube(rx, ry, rz);
	}

	private static (int Column, int Row) CubeToOddR(Cube cube)
	{
		var row = cube.Z;
		var column = cube.X + ((row - (row & 1)) / 2);
		return (column, row);
	}

	private static (int Column, int Row) Step(int column, int row, HexDirection direction)
	{
		var isEvenRow = row % 2 == 0;

		return direction switch
		{
			HexDirection.East => (column + 1, row),
			HexDirection.NorthEast => isEvenRow ? (column, row - 1) : (column + 1, row - 1),
			HexDirection.NorthWest => isEvenRow ? (column - 1, row - 1) : (column, row - 1),
			HexDirection.West => (column - 1, row),
			HexDirection.SouthWest => isEvenRow ? (column - 1, row + 1) : (column, row + 1),
			HexDirection.SouthEast => isEvenRow ? (column, row + 1) : (column + 1, row + 1),
			_ => (column, row)
		};
	}

	private static int GetShortestTurnDelta(HexDirection from, HexDirection to)
	{
		var clockwise = (((int)to - (int)from) + 6) % 6;
		var counterClockwise = (((int)from - (int)to) + 6) % 6;
		return clockwise <= counterClockwise ? 1 : -1;
	}

	private static int GetDirectionDistance(HexDirection a, HexDirection b)
	{
		var diff = Math.Abs((int)a - (int)b);
		return Math.Min(diff, 6 - diff);
	}

	private static HexDirection? GetDirectionToward(int fromColumn, int fromRow, int toColumn, int toRow)
	{
		if (fromColumn == toColumn && fromRow == toRow)
		{
			return null;
		}

		var origin = OddRToCube(fromColumn, fromRow);
		var target = OddRToCube(toColumn, toRow);
		var delta = new Cube(target.X - origin.X, target.Y - origin.Y, target.Z - origin.Z);

		var bestDirection = HexDirection.East;
		var bestDot = int.MinValue;

		foreach (var candidate in Enum.GetValues<HexDirection>())
		{
			var vector = GetCubeDirectionVector(candidate);
			var dot = (delta.X * vector.X) + (delta.Y * vector.Y) + (delta.Z * vector.Z);
			if (dot > bestDot)
			{
				bestDot = dot;
				bestDirection = candidate;
			}
		}

		return bestDirection;
	}

	private static Cube GetCubeDirectionVector(HexDirection direction) => direction switch
	{
		HexDirection.East => new Cube(1, -1, 0),
		HexDirection.NorthEast => new Cube(1, 0, -1),
		HexDirection.NorthWest => new Cube(0, 1, -1),
		HexDirection.West => new Cube(-1, 1, 0),
		HexDirection.SouthWest => new Cube(-1, 0, 1),
		HexDirection.SouthEast => new Cube(0, -1, 1),
		_ => new Cube(0, 0, 0)
	};

	private static int CubeDistance(int columnA, int rowA, int columnB, int rowB)
	{
		var a = OddRToCube(columnA, rowA);
		var b = OddRToCube(columnB, rowB);
		return (Math.Abs(a.X - b.X) + Math.Abs(a.Y - b.Y) + Math.Abs(a.Z - b.Z)) / 2;
	}

	private static Cube OddRToCube(int column, int row)
	{
		var x = column - ((row - (row & 1)) / 2);
		var z = row;
		var y = -x - z;
		return new Cube(x, y, z);
	}

	private readonly record struct CubeD(double X, double Y, double Z);

	private readonly record struct Cube(int X, int Y, int Z);
}
