@page "/"
@using MechWar.Data
@using MechWar.Models
@using MechWar.Services
@inject GameUiState UiState
@inject NavigationManager Nav

<PageTitle>MechWar — Mission Briefing</PageTitle>

<div class="lobby-layout">
    <div class="lobby-card">
        <h1 class="lobby-title">⚙ MECHWAR</h1>
        <p class="lobby-subtitle">Configure your engagement, Commander.</p>

        <div class="lobby-form">
            <div class="lobby-section">
                <h2>Battlefield</h2>
                <div class="lobby-row">
                    <div class="lobby-field">
                        <label for="theme">Theme</label>
                        <select id="theme" class="form-select form-select-sm" @bind="SelectedThemeKey">
                            @foreach (var theme in ThemeCatalog.All)
                            {
                                <option value="@theme.Key">@theme.DisplayName</option>
                            }
                        </select>
                    </div>
                    <div class="lobby-field">
                        <label for="width">Width</label>
                        <input id="width" class="form-control form-control-sm" type="number" min="@MinMapWidth" max="@MaxMapWidth" @bind="Width" />
                    </div>
                    <div class="lobby-field">
                        <label for="height">Height</label>
                        <input id="height" class="form-control form-control-sm" type="number" min="@MinMapHeight" max="@MaxMapHeight" @bind="Height" />
                    </div>
                </div>
            </div>

            <div class="lobby-section">
                <h2>Combatants</h2>
                <div class="lobby-row">
                    <div class="lobby-field">
                        <label for="playerMech">Your Mech</label>
                        <select id="playerMech" class="form-select form-select-sm" @bind="SelectedPlayerMechName">
                            @foreach (var mechName in MechCatalog.AllMechNames)
                            {
                                <option value="@mechName">@mechName</option>
                            }
                        </select>
                        @if (PlayerDef is not null)
                        {
                            <span class="mech-hint">@PlayerDef.Tonnage t · Walk @PlayerDef.WalkSpeed / Run @PlayerDef.RunSpeed@(PlayerDef.JumpSpeed > 0 ? $" / Jump {PlayerDef.JumpSpeed}" : "") · @PlayerDef.Weapons.Count weapons</span>
                        }
                    </div>
                    <div class="lobby-field vs-label-wrapper">
                        <span class="vs-label">VS</span>
                    </div>
                    <div class="lobby-field">
                        <label for="enemyMech">Enemy Mech</label>
                        <select id="enemyMech" class="form-select form-select-sm" @bind="SelectedEnemyMechName">
                            @foreach (var mechName in MechCatalog.AllMechNames)
                            {
                                <option value="@mechName">@mechName</option>
                            }
                        </select>
                        @if (EnemyDef is not null)
                        {
                            <span class="mech-hint">@EnemyDef.Tonnage t · Walk @EnemyDef.WalkSpeed / Run @EnemyDef.RunSpeed@(EnemyDef.JumpSpeed > 0 ? $" / Jump {EnemyDef.JumpSpeed}" : "") · @EnemyDef.Weapons.Count weapons</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        @if (!IsFormValid)
        {
            <p class="lobby-validation">@ValidationMessage</p>
        }
        <p class="lobby-spawn-preview">@SpawnPreview</p>

        <div class="lobby-actions">
            <button class="btn btn-primary btn-lg lobby-start-btn" @onclick="StartGame" disabled="@(!IsFormValid)">
                ▶ Deploy &amp; Fight
            </button>
        </div>
    </div>
</div>

@code {
    private const int MinMapWidth = 8;
    private const int MaxMapWidth = 80;
    private const int MinMapHeight = 8;
    private const int MaxMapHeight = 60;

    private string SelectedThemeKey { get; set; } = ThemeCatalog.All[0].Key;
    private int Width { get; set; } = 28;
    private int Height { get; set; } = 20;
    private string SelectedPlayerMechName { get; set; } = "Jenner JR7-D";
    private string SelectedEnemyMechName { get; set; } = "Hunchback HBK-4G";

    private MechDefinition? PlayerDef => MechCatalog.Get(SelectedPlayerMechName);
    private MechDefinition? EnemyDef => MechCatalog.Get(SelectedEnemyMechName);

    private bool IsFormValid => Width >= MinMapWidth && Width <= MaxMapWidth && Height >= MinMapHeight && Height <= MaxMapHeight;

    private string ValidationMessage => $"Map size must be between {MinMapWidth}-{MaxMapWidth} wide and {MinMapHeight}-{MaxMapHeight} high.";

    private string SpawnPreview
    {
        get
        {
            if (!IsFormValid) return "Set a valid map size to preview spawn bands.";
            var min = Math.Min(3, Math.Max(1, (Width / 2) - 1));
            var max = Math.Min(6, Math.Max(min, Width - 2));
            return $"Mechs spawn on opposite sides, {min}–{max} hexes from each edge, any row 0–{Height - 1}.";
        }
    }

    private void StartGame()
    {
        if (!IsFormValid) return;
        UiState.RequestNewGame(SelectedThemeKey, Width, Height, SelectedPlayerMechName, SelectedEnemyMechName);
        Nav.NavigateTo("/game");
    }
}
