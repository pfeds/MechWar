	private string BuildMechTooltip(
		string title,
		PlayerMech mech,
		Dictionary<HitLocation, SectionState> sections,
		Dictionary<HitLocation, List<ComponentStatus>> components,
		int heat,
		bool shutdown,
		bool ammoIntact,
		MovementMode mode)
	{
		TileByCoordinate.TryGetValue((mech.Column, mech.Row), out var occupiedTile);
		var terrainContext = occupiedTile is null
			? "Unknown"
			: BuildTileContext(occupiedTile);

		var lines = new List<string>
		{
			title,
			$"Class: {mech.Class}",
			$"Facing: {mech.Facing}",
			$"Hex: ({mech.Column}, {mech.Row}) {terrainContext}",
			$"Mode: {mode}",
			$"Movement: {mech.RemainingMovement}/{mech.MaxMovement}",
			$"Heat: {heat} ({(shutdown ? "Shutdown" : "Online")})",
			$"Ammo: {(ammoIntact ? "Safe" : "Exploded")}",
			"Damage by location (Armor/Internal):"
		};

		foreach (var location in Enum.GetValues<HitLocation>())
		{
			if (sections.TryGetValue(location, out var section))
			{
				lines.Add($"- {FormatLocation(location)}: {Math.Max(0, section.Armor)}/{Math.Max(0, section.Internal)}");
			}
		}

		var criticalLines = new List<string>();
		foreach (var (location, parts) in components)
		{
			foreach (var part in parts.Where(part => part.IsDestroyed))
			{
				criticalLines.Add($"- {FormatLocation(location)} {FormatComponentType(part.Type)}");
			}
		}

		if (criticalLines.Count == 0)
		{
			lines.Add("Critical damage: None");
		}
		else
		{
			lines.Add("Critical damage:");
			lines.AddRange(criticalLines);
		}

		return string.Join("\n", lines);
	}

	private static string BuildTileContext(HexTile tile)
	{
		if (tile.HillLevel is int hillLevel)
		{
			return $"{TerrainCatalog.GetLabel(tile.Terrain)} Level {hillLevel}";
		}

		if (tile.WaterDepth is int waterDepth)
		{
			return $"{TerrainCatalog.GetLabel(tile.Terrain)} Depth {waterDepth}";
		}

		return TerrainCatalog.GetLabel(tile.Terrain);
	}

	private static string FormatComponentType(ComponentType type) => type switch
	{
		ComponentType.Engine => "Engine",
		ComponentType.Gyro => "Gyro",
		ComponentType.Weapon => "Weapon",
		ComponentType.JumpJet => "JumpJet",
		_ => "Unknown"
	};

	private void CheckGameOver()
	{
		// BATTLETECHCOMPLIANCE: Check for specific section destructions per official rules

		// CHECK 1: Center Torso destroyed = instant loss (engine destroyed)
		if (PlayerSections[HitLocation.CenterTorso].Internal <= 0)
		{
			IsGameOver = true;
			PlayerWon = false;
			LastActionMessage = "Your Center Torso destroyed! Engine destroyed! Mech destroyed!";
			ShowDestructionOverlay(true, "Center Torso destroyed!");
			return;
		}

		if (EnemySections[HitLocation.CenterTorso].Internal <= 0)
		{
			IsGameOver = true;
			PlayerWon = true;
			LastActionMessage = "Enemy Center Torso destroyed! Engine destroyed! Enemy mech destroyed!";
			ShowDestructionOverlay(false, "Center Torso destroyed!");
			return;
		}

		// CHECK 2: Both side torsos destroyed = instant loss (structural failure)
		if (PlayerSections[HitLocation.LeftTorso].Internal <= 0 &&
			PlayerSections[HitLocation.RightTorso].Internal <= 0)
		{
			IsGameOver = true;
			PlayerWon = false;
			LastActionMessage = "Both side torsos destroyed! Structural failure! Mech destroyed!";
			ShowDestructionOverlay(true, "Both torsos destroyed!");
			return;
		}

		if (EnemySections[HitLocation.LeftTorso].Internal <= 0 &&
			EnemySections[HitLocation.RightTorso].Internal <= 0)
		{
			IsGameOver = true;
			PlayerWon = true;
			LastActionMessage = "Enemy both side torsos destroyed! Structural failure! Enemy mech destroyed!";
			ShowDestructionOverlay(false, "Both torsos destroyed!");
			return;
		}

		// CHECK 3: Head destroyed = instant loss (pilot/cockpit destroyed)
		if (PlayerSections[HitLocation.Head].Internal <= 0)
		{
			IsGameOver = true;
			PlayerWon = false;
			LastActionMessage = "Your Head destroyed! Pilot dead! Mech destroyed!";
			ShowDestructionOverlay(true, "Head destroyed!");
			return;
		}

		if (EnemySections[HitLocation.Head].Internal <= 0)
		{
			IsGameOver = true;
			PlayerWon = true;
			LastActionMessage = "Enemy Head destroyed! Enemy pilot dead! Enemy mech destroyed!";
			ShowDestructionOverlay(false, "Head destroyed!");
			return;
		}

		// CHECK 4: Total internal structure = 0 (fallback check)
		if (PlayerInternal <= 0)
		{
			IsGameOver = true;
			PlayerWon = false;
		}
		else if (EnemyInternal <= 0)
		{
			IsGameOver = true;
			PlayerWon = true;
		}
	}

	/// <summary>
	/// Shows a destruction message in the overhead impact text overlay.
