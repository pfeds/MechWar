	private void AddConsoleLine(string? line)
	{
		if (string.IsNullOrWhiteSpace(line))
		{
			return;
		}

		var type = ClassifyLogLine(line);
		var entry = $"> {line}";

		// Insert at top so newest messages appear first
		if (CombatLog.Count > 0 && CombatLog[0] == entry)
		{
			return;
		}

		CombatLog.Insert(0, entry);
		if (CombatLog.Count > 120)
		{
			CombatLog.RemoveAt(CombatLog.Count - 1);
		}
	}

	private static LogEntryType ClassifyLogLine(string line)
	{
		// Destruction: any Critical or section/mech destroyed message
		if (line.Contains("CRITICAL", StringComparison.OrdinalIgnoreCase) ||
			line.Contains("destroyed", StringComparison.OrdinalIgnoreCase) ||
			line.Contains("explosion", StringComparison.OrdinalIgnoreCase))
		{
			return LogEntryType.Destruction;
		}

		// Hit messages
		if (line.StartsWith("HIT", StringComparison.OrdinalIgnoreCase) ||
			line.StartsWith("Enemy HIT", StringComparison.OrdinalIgnoreCase))
		{
			return LogEntryType.Hit;
		}

		// Miss messages
		if (line.StartsWith("MISS", StringComparison.OrdinalIgnoreCase) ||
			line.StartsWith("Enemy MISS", StringComparison.OrdinalIgnoreCase))
		{
			return LogEntryType.Miss;
		}

		return LogEntryType.Normal;
	}

	private static string GetLogCssClass(string line) => ClassifyLogLine(line) switch
	{
		LogEntryType.Hit         => "log-hit",
		LogEntryType.Miss        => "log-miss",
