@inherits LayoutComponentBase
@inject NavigationManager Nav
<div class="page">
    <header class="top-bar">
        <div class="top-bar-left">
            <h1 class="top-bar-logo">⚙ MECHWAR</h1>
        </div>
        <div class="top-bar-right">
            <NavMenu/>
        </div>
    </header>
    <main>
        <article class="@GetContentClass()">
            @Body
        </article>
    </main>
</div>

@code {
    private string GetContentClass() => IsGameRoute() ? "content content-game" : "content";

    private bool IsGameRoute()
    {
        var relativePath = Nav.ToBaseRelativePath(Nav.Uri).Trim('/');
        return string.Equals(relativePath, "game", StringComparison.OrdinalIgnoreCase);
    }
}
